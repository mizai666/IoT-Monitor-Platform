// 阈值实时监测：每轮数据加载后调用
// ========== 阈值报警通知（全局，见 hooks/useAlarmCenter.js） ==========

// 报警时发送自定义 JSON 指令给下位机
const sendThresholdAlarmJson = (jsonStr, topic) => {
  let payload
  try {
    payload = JSON.parse(jsonStr)
    if (typeof payload !== 'object' || payload === null) throw new Error('JSON 必须是对象')
  } catch (e) {
    console.error('报警JSON指令格式错误:', jsonStr, e)
    return
  }
  ensureSwitchMqttClient().then(() => {
    const msg = new mqtt.Message(JSON.stringify(payload))
    msg.destinationName = topic
    msg.qos = 0
    switchMqttClient.send(msg)
    console.log('[阈值报警] 已发送JSON指令 topic=', topic, 'payload=', JSON.stringify(payload))
  }).catch(e => console.error('报警JSON发送失败', e))
}

const checkThresholds = () => {
  const now = Date.now()
  for (const th of thresholds.value) {
    if (th.enabled !== 1) continue
    // 尝试精确匹配，再尝试去除尾部数字后匹配
    let item = realtimeDataList.value.find(d => d.key === th.sensor_key)
    if (!item) {
      const normalized = stripTrailingNum(th.sensor_key)
      item = realtimeDataList.value.find(d => d.key === normalized)
    }
    if (!item) continue
    const val = parseFloat(item.value)
    if (isNaN(val)) continue
    const min = parseFloat(th.min_value)
    const max = parseFloat(th.max_value)
    if (val < min || val > max) {
      // 防抖：同一阈值 10 秒内不重复报警
      const lastKey = `t_${th.id}`
      const lastTime = thresholdLastAlarm.value[lastKey] || 0
      if (now - lastTime < 10000) continue
      thresholdLastAlarm.value[lastKey] = now
      const msg = th.alarm_message || `${th.display_name} 异常: ${val} (范围 ${min}~${max})`
      addAlarmNotification({ deviceName: deviceName.value, displayName: th.display_name, message: msg })
      recordAlarm({
        deviceId: deviceId.value,
        thresholdId: th.id,
        sensorKey: th.sensor_key,
        currentValue: String(val),
        alarmMessage: msg,
        minValue: min,
        maxValue: max,
        alarmTime: now
      }).catch(e => console.error('记录报警失败', e))
      // 报警时发送自定义 JSON 指令给下位机
      if (th.alarm_send_json && th.publish_topic) {
        sendThresholdAlarmJson(th.alarm_send_json, th.publish_topic)
      }
    }
  }
}

// ========== 定时倒计时 ==========
const getScheduleCountdown = (sch) => {
  if (sch.enabled !== 1) return '已禁用'
  // 读取 countdownTick 使此函数具有响应式
  void countdownTick.value
  const totalSeconds = parseInt(sch.schedule_time) || 0
  const startTime = scheduleStartTimes.value.get(sch.id)
  if (!startTime) return `${totalSeconds} 秒间隔`
  const elapsed = Math.floor((Date.now() - startTime) / 1000)
  const remain = Math.max(0, totalSeconds - elapsed)
  return `倒计时 ${remain} 秒`
}

