// ========== 自动开关 ==========
const autoSwitchConfig = ref(null)
const currentMode = ref('manual')
const showAutoSwitchForm = ref(false)
const autoSwitchForm = ref({
  keyName: '',
  autoValue: '',
  manualValue: '',
  publishTopic: ''
})

const loadAutoSwitch = async () => {
  try {
    autoSwitchConfig.value = await getAutoSwitchConfig(deviceId.value)
    if (autoSwitchConfig.value) {
      autoSwitchForm.value = {
        keyName: autoSwitchConfig.value.key_name || '',
        autoValue: autoSwitchConfig.value.auto_value || '',
        manualValue: autoSwitchConfig.value.manual_value || '',
        publishTopic: autoSwitchConfig.value.publish_topic || ''
      }
      currentMode.value = autoSwitchConfig.value.current_mode || 'manual'
    }
    updateAutoMode()
  } catch (err) {
    console.error('加载自动开关配置失败', err)
  }
}

const updateAutoMode = () => {
  const cfg = autoSwitchConfig.value
  if (!cfg || !cfg.key_name) return
  let item = realtimeDataList.value.find(d => d.key === cfg.key_name)
  if (!item) {
    const normalized = stripTrailingNum(cfg.key_name)
    item = realtimeDataList.value.find(d => d.key === normalized)
  }
  if (!item) return
  const val = String(item.value)
  if (cfg.auto_value && val === String(cfg.auto_value)) {
    currentMode.value = 'auto'
  } else if (cfg.manual_value && val === String(cfg.manual_value)) {
    currentMode.value = 'manual'
  }
}

const sendModePayload = (payload, topic) => {
  if (!payload || !topic) return
  ensureSwitchMqttClient().then(() => {
    const msg = new mqtt.Message(payload)
    msg.destinationName = topic
    msg.qos = 0
    switchMqttClient.send(msg)
  }).catch(e => console.error('模式指令发送失败', e))
}

const parseModeValue = (v) => {
  const s = String(v).trim()
  if (/^-?\d+(\.\d+)?$/.test(s)) return Number(s)
  return s
}

const switchToAuto = () => {
  if (deviceOffline.value) {
    uni.showToast({ title: '设备离线，无法操作', icon: 'none' })
    return
  }
  currentMode.value = 'auto'
  updateAutoSwitchMode(deviceId.value, 'auto').catch(e => console.error('保存模式失败', e))
  const cfg = autoSwitchConfig.value
  if (cfg && cfg.key_name) {
    if (cfg.publish_topic) {
      sendModePayload(JSON.stringify({ [cfg.key_name]: parseModeValue(cfg.auto_value) }), cfg.publish_topic)
    }
    // 把下发的模式值也存进传感器历史，保证接收/发送按时间取最新
    saveSensorData(parseInt(deviceId.value), cfg.key_name, parseModeValue(cfg.auto_value), Date.now()).catch(e => console.error('记录模式失败', e))
  }
}

const switchToManual = () => {
  if (deviceOffline.value) {
    uni.showToast({ title: '设备离线，无法操作', icon: 'none' })
    return
  }
  currentMode.value = 'manual'
  updateAutoSwitchMode(deviceId.value, 'manual').catch(e => console.error('保存模式失败', e))
  const cfg = autoSwitchConfig.value
  if (cfg && cfg.key_name) {
    if (cfg.publish_topic) {
      sendModePayload(JSON.stringify({ [cfg.key_name]: parseModeValue(cfg.manual_value) }), cfg.publish_topic)
    }
    saveSensorData(parseInt(deviceId.value), cfg.key_name, parseModeValue(cfg.manual_value), Date.now()).catch(e => console.error('记录模式失败', e))
  }
}

