// 定时检查器：每30秒检查是否有到时间的定时任务
const checkSchedules = async () => {
  const now = Date.now()
  for (const sch of schedules.value) {
    if (sch.enabled !== 1) continue
    const totalSeconds = parseInt(sch.schedule_time) || 0
    if (totalSeconds <= 0) continue
    let startTime = scheduleStartTimes.value.get(sch.id)
    if (!startTime) { scheduleStartTimes.value.set(sch.id, now); continue }
    const elapsed = (now - startTime) / 1000
    if (elapsed < totalSeconds) continue
    if (sch._lastExecuted === startTime) continue
    sch._lastExecuted = startTime
    // 执行定时任务
    const activeHigh = sch.active_high === 1
    const sendValue = sch.target_state === 1 ? (activeHigh ? 1 : 0) : (activeHigh ? 0 : 1)
    const payload = JSON.stringify({ [sch.key_name]: sendValue })
    try {
      await ensureSwitchMqttClient()
      const msg = new mqtt.Message(payload)
      msg.destinationName = sch.publish_topic
      msg.qos = 0
      switchMqttClient.send(msg)
      // 下发的定时指令同步更新实时数据区与开关状态（与手动开关一致）
      handleRealtimeMqttMessage(payload)
      const sw = switches.value.find((s: any) =>
        s.key_name === sch.key_name || stripTrailingNum(s.key_name) === stripTrailingNum(sch.key_name)
      )
      if (sw && sw.isOn !== (sch.target_state === 1)) {
        sw.isOn = sch.target_state === 1
        updateSwitchState(sw.id, sw.isOn).catch(e => console.error('保存开关状态失败', e))
      }
      recordSendHistory(sch.publish_topic, payload)
      saveSensorData(parseInt(deviceId.value), sch.key_name, sendValue, Date.now()).catch(e => console.error('记录定时开关状态失败', e))
      await executeSchedule(sch.id)
      console.log('定时任务执行:', sch.display_name, payload)
    } catch (err) {
      console.error('定时任务执行失败', err)
    } finally {
      // 无论成功失败都重置计时，避免失败后卡住不再执行
      scheduleStartTimes.value.set(sch.id, now)
      sch._lastExecuted = null
    }
  }
}

// ========== 阈值管理 ==========
const thresholds = ref([])
const showThresholdForm = ref(false)
const editingThreshold = ref(null)
const thresholdForm = ref({
  sensorKey: '',
  displayName: '',
  minValue: '',
  maxValue: '',
  alarmMessage: '',
  sendToDevice: false,
  upperKey: '',
  lowerKey: '',
  publishTopic: '',
  enabled: true,
  respMaxPath: '',
  respMinPath: '',
  alarmSendJson: ''
})
const savingThreshold = ref(false)
const thresholdLastAlarm = ref({})

const loadThresholds = async () => {
  try {
    const data = await getThresholdConfigs(deviceId.value)
    thresholds.value = data
  } catch (err) {
    console.error('加载阈值列表失败', err)
  }
}

const openAddThresholdForm = () => {
  editingThreshold.value = null
  thresholdForm.value = { sensorKey: '', displayName: '', minValue: '', maxValue: '', alarmMessage: '', sendToDevice: false, upperKey: '', lowerKey: '', publishTopic: '', enabled: true, respMaxPath: '', respMinPath: '', alarmSendJson: '' }
  showThresholdForm.value = true
}

const closeThresholdForm = () => {
  showThresholdForm.value = false
}

const saveThreshold = async () => {
  if (savingThreshold.value) return
  const { sensorKey, displayName, minValue, maxValue, alarmMessage, sendToDevice, upperKey, lowerKey, publishTopic, enabled, respMaxPath, respMinPath, alarmSendJson } = thresholdForm.value
  if (!sensorKey.trim() || !displayName.trim() || minValue === '' || maxValue === '' || !upperKey.trim() || !lowerKey.trim()) {
    uni.showToast({ title: '请填写完整信息', icon: 'none' })
    return
  }
  if (sendToDevice && !publishTopic.trim()) {
    uni.showToast({ title: '发送至设备需填写发布主题', icon: 'none' })
    return
  }
  savingThreshold.value = true
  try {
    const payload = {
      sensorKey: sensorKey.trim(),
      displayName: displayName.trim(),
      minValue: parseFloat(minValue),
      maxValue: parseFloat(maxValue),
      alarmMessage: alarmMessage.trim(),
      sendToDevice,
      upperKey: upperKey.trim(),
      lowerKey: lowerKey.trim(),
      publishTopic: publishTopic.trim(),
      enabled: enabled ? 1 : 0,
      respMaxPath: respMaxPath.trim(),
      respMinPath: respMinPath.trim(),
      alarmSendJson: alarmSendJson.trim()
    }
    if (editingThreshold.value) {
      await updateThresholdConfig(editingThreshold.value.id, payload)
      uni.showToast({ title: '修改成功', icon: 'success' })
    } else {
      await createThresholdConfig({ deviceId: deviceId.value, ...payload })
      uni.showToast({ title: '添加成功', icon: 'success' })
    }
    showThresholdForm.value = false
    await loadThresholds()
    // 发送至设备：异步发布，不阻塞保存流程
    if (sendToDevice && publishTopic.trim()) {
      const upperKeyVal = upperKey.trim()
      const lowerKeyVal = lowerKey.trim()
      const topic = publishTopic.trim()
      const maxVal = parseFloat(maxValue)
      const minVal = parseFloat(minValue)
      ensureSwitchMqttClient().then(() => {
        const payloadJson = JSON.stringify({ [upperKeyVal]: maxVal, [lowerKeyVal]: minVal })
        const msg = new mqtt.Message(payloadJson)
        msg.destinationName = topic
        msg.qos = 0
        switchMqttClient.send(msg)
      }).catch(e => console.error('阈值发送失败', e))
    }
  } catch (err) {
    uni.showToast({ title: '保存失败', icon: 'error' })
  } finally {
    savingThreshold.value = false
  }
}

const openThresholdAction = (th) => {
  uni.showActionSheet({
    itemList: ['修改', '删除'],
    success: (res) => {
      if (res.tapIndex === 0) {
        editingThreshold.value = th
        thresholdForm.value = {
          sensorKey: th.sensor_key,
          displayName: th.display_name,
          minValue: String(th.min_value),
          maxValue: String(th.max_value),
          alarmMessage: th.alarm_message || '',
          sendToDevice: th.send_to_device === 1,
          upperKey: th.upper_key || '',
          lowerKey: th.lower_key || '',
          publishTopic: th.publish_topic || '',
          enabled: th.enabled === 1,
