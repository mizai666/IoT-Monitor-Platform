  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx;
  align-content: flex-start;
}

.switch-card {
  flex: 0 0 calc(33.33% - 14rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e0e0e0;
  background: #fafafa;
  gap: 16rpx;
  min-height: 200rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}

.switch-card.is-on {
  background: #e8f5e9;
  border-color: #4cd964;
}

.switch-card-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.switch-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.switch-key-hint {
  font-size: 20rpx;
  color: #999;
}

.switch-toggle {
  transform: scale(1.2);
}

/* 添加卡片 */
.switch-card.add-card {
  border-style: dashed;
  border-color: #ccc;
  background: #fff;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #007aff;
  font-weight: 300;
  line-height: 1;
}

.add-label {
  font-size: 24rpx;
  color: #999;
}

/* 列表中添加卡片 */
.add-item-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 20rpx;
  margin: 12rpx 16rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx dashed #ccc;
}

.add-item-card .add-icon {
  font-size: 40rpx;
  color: #007aff;
  font-weight: 300;
  line-height: 1;
}

.add-item-card .add-label {
  font-size: 24rpx;
  color: #999;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-card {
  width: 1000rpx;
  max-width: 94vw;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.modal-body {
  padding: 30rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 24rpx 20rpx;
  align-items: flex-start;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: calc(50% - 10rpx);
}

.form-error {
  width: 100%;
  background: #FDECEA;
  color: #E53935;
  font-size: 26rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #F5C6C4;
}

.form-item-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.form-divider {
  padding: 16rpx 0 8rpx 0;
  margin-top: 8rpx;
  border-top: 1px solid #e0e0e0;
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.form-divider text {
  font-size: 22rpx;
  color: #999;
}
.example-link {
  font-size: 24rpx;
  color: #007aff;
  font-weight: 500;
}

.form-input {
  height: 64rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  background: #fafafa;
}

.form-item-full {
  width: 100%;
}

.form-textarea {
  width: 100%;
  min-height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  background: #fafafa;
  line-height: 1.5;
}

.raw-json-edit-area {
  height: 480rpx;
  font-family: monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: #007aff;
  color: #fff;
}

.modal-btn:active {
  opacity: 0.7;
}

/* ========== 设备控制子标签 ========== */
.control-tabs {
  display: flex;
  flex-direction: row;
  border-bottom: 2rpx solid #e0e0e0;
  flex-shrink: 0;
  background: #fafafa;
}

.control-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.control-tab.active {
  color: #007aff;
  border-bottom-color: #007aff;
  font-weight: 500;
}

.control-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

/* ========== 主题控制 ========== */
.theme-nav-bar {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}
.theme-nav-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: 2rpx solid #ccc;
  font-size: 26rpx;
}
.theme-nav-btn.active {
  font-weight: 600;
}
.theme-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.theme-card {
  position: relative;
}
.theme-card-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
}
.theme-active-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #007aff;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 0 0 12rpx;
}
.theme-active-text {
  color: #fff;
}
.theme-select {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  height: 72rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  border: 1rpx solid #e0e0e0;
}
.theme-select-value {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}
.theme-select-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.theme-select-arrow {
  color: #999;
  font-size: 24rpx;
}
.theme-dropdown {
  margin-top: 8rpx;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}
.theme-dropdown-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.theme-dropdown-item:last-child {
  border-bottom: none;
}
.theme-dropdown-item.active {
  background: #f0f7ff;
  color: #007aff;
}

/* ========== 定时任务列表 ========== */
.schedule-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.schedule-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow-y: auto;
}

.schedule-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  margin: 12rpx 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  gap: 16rpx;
}

.schedule-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.schedule-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.schedule-key {
  font-size: 20rpx;
  color: #999;
}

.schedule-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.schedule-time {
  font-size: 32rpx;
  font-weight: bold;
  color: #007aff;
}

.schedule-target {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
}

.schedule-countdown {
  font-size: 22rpx;
  color: #ff9500;
  font-weight: 500;
}

.schedule-enable {
  flex-shrink: 0;
  transform: scale(1.1);
}

/* ========== 分段选择器 ========== */
.segmented {
  display: flex;
  flex-direction: row;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  overflow: hidden;
}

.seg-item {
  padding: 10rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #fafafa;
}

.seg-item.active {
  background: #007aff;
  color: #fff;
}

.time-input {
  width: 160rpx;
  text-align: center;
}

/* ========== 阈值设定列表 ========== */
.threshold-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  margin: 12rpx 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  gap: 16rpx;
}

.threshold-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.threshold-header {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}

.threshold-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.threshold-key {
  font-size: 20rpx;
  color: #999;
}

.threshold-range {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.range-min, .range-max {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
}

.range-sep {
  color: #ccc;
  font-size: 20rpx;
}

.threshold-msg {
  font-size: 22rpx;
  color: #ff9500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.threshold-send-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.send-tag {
  font-size: 20rpx;
  background: #e8f4ff;
  color: #007aff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.send-topic {
  font-size: 20rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.threshold-enable {
  flex-shrink: 0;
  transform: scale(1.1);
}

/* 表单额外区域 */
.form-extra {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 24rpx 20rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border-left: 4rpx solid #007aff;
  width: 100%;
}

// ========== 监控画面样式 ==========
.webview-panel {
  flex-direction: column;
  padding: 20rpx;
}

.webview-url-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.publish-btn.connect {
  background: #007aff;
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
}

.publish-btn.connect text {
  color: #fff;
  font-size: 26rpx;
}

.connection-status {
  flex-direction: row;
  align-items: center;
  margin-left: 20rpx;
}

.connection-status .status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  margin-right: 8rpx;
}

.connection-status.connected .status-dot {
  background: #4cd964;
}

// 左右布局
.webview-main {
  flex-direction: row;
  flex: 1;
  overflow: hidden;
}

.webview-box {
  flex: 1;
  margin-right: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #ddd;
}

.webview-webview {
  width: 100%;
  height: 100%;
}

.webview-screenshot-side {
  width: 300rpx;
  flex-direction: column;
}

.webview-screenshot-side .sub-title {
  margin-bottom: 12rpx;
}

// 截图预览弹窗
.screenshot-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}

.screenshot-dialog {
  width: 700rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.screenshot-dialog-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.screenshot-dialog-title {
  font-size: 32rpx;
  font-weight: 600;
}

.screenshot-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.screenshot-dialog-body {
  padding: 20rpx;
  overflow-y: auto;
  max-height: 60vh;
}

.screenshot-preview-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.screenshot-section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.screenshot-detection-list {
  flex-direction: row;
  flex-wrap: wrap;
}

.detection-tag {
  flex-direction: row;
  align-items: center;
  background: #f0f0ff;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #667eea;
}

.detection-class {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.detection-conf {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

// 截图历史
.screenshot-history-list {
  flex: 1;
  height: 0;
  overflow-y: auto;
}

.screenshot-history-item {
  flex-direction: row;
  align-items: center;
  padding: 12rpx;
  margin-bottom: 10rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.screenshot-thumb {
  width: 80rpx;
  height: 60rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  background: #ddd;
}

.screenshot-info {
  flex-direction: column;
  flex: 1;
}

.screenshot-source {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
}

.screenshot-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

// ========== 数据查询样式 ==========
.query-panel {
  flex-direction: column;
  overflow: hidden;
}

.query-form {
  flex-shrink: 0;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border-bottom: 1rpx solid #eee;
}

.query-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.query-label {
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  width: 120rpx;
  flex-shrink: 0;
}
.query-label-time {
  width: 76rpx;
}

.query-input {
  flex: 1;
  height: 56rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  background: #fff;
}

.query-field-picker {
  min-width: 140rpx;
  text-align: center;
  flex-shrink: 0;
}

.query-btn-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.query-sort-hint {
  font-size: 22rpx;
  color: #999;
}
.sort-icon {
  font-size: 20rpx;
  color: #bbb;
  margin-left: 4rpx;
}
.sort-icon.sort-active {
  color: #667eea;
}
.query-btn-right {
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.query-seg .seg-item {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
}

.publish-btn.clear {
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.query-result {
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  overflow: hidden;
}

.query-total {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  flex-shrink: 0;
}

.query-pagination {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
}
.pg-btn {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: #007aff;
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  background: #fff;
  white-space: nowrap;
}
.pg-disabled {
  color: #c0c4cc;
  border-color: #e4e7ed;
  background: #f5f7fa;
}
.pg-page-item {
  flex-direction: row;
  align-items: center;
}
.pg-num {
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #333;
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  background: #fff;
}
.pg-active {
  color: #fff;
  background: #409eff;
  border-color: #409eff;
}
.pg-ellipsis {
  padding: 0 8rpx;
  color: #999;
  font-size: 24rpx;
}
.pg-size-picker {
  height: 56rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  background: #fff;
}
.pg-size-val {
  font-size: 24rpx;
  color: #333;
}
.pg-jump {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #333;
}
.pg-jump-input {
  width: 80rpx;
  height: 56rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  text-align: center;
  font-size: 24rpx;
  background: #fff;
}
.pg-jump-btn {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #fff;
  background: #409eff;
  border-radius: 6rpx;
  white-space: nowrap;
}

.query-table-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow-y: auto;
}

.query-table {
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}

.query-thead {
  display: flex;
  flex-direction: row;
  background: #f5f5f5;
  border-bottom: 2rpx solid #e0e0e0;
}

.query-tr {
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid #f0f0f0;
}

.query-tr:last-child {
  border-bottom: none;
}

.query-tr-img {
  min-height: 100rpx;
}

.th, .td {
  flex: 1;
  font-size: 22rpx;
  padding: 12rpx 10rpx;
  color: #333;
  word-break: break-all;
  border-right: 1rpx solid #f0f0f0;
}

.th {
  font-weight: 600;
  color: #666;
  background: #f5f5f5;
}

.td {
  background: #fff;
}

