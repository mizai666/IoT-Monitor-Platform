<template>
  <view :class="['detail-container', activeThemeClass]">
    <!-- 自定义导航栏 -->
    <view class="custom-nav">
      <view class="nav-left">
        <view class="nav-back" @click="goBack">
          <text class="back-icon">←</text>
        </view>
        <text class="nav-title">{{ deviceName }}</text>
      </view>
      <view class="nav-center"></view>
      <view class="nav-right"></view>
    </view>

    <!-- 主体内容：三列布局 -->
    <view class="main-content">
      <!-- 左侧：菜单列表 + 订阅信息 -->
      <view class="left-side">
        <scroll-view class="menu-list" scroll-y>
          <view
            v-for="(item, idx) in menus"
            :key="idx"
            class="menu-item"
            :class="{ active: currentMenu === item.value }"
            @click="currentMenu = item.value"
          >
            {{ item.label }}
          </view>
        </scroll-view>
        <view class="subscription-info">
          <view class="info-row">端口号: {{ port }}</view>
          <view class="info-row">订阅主题: {{ topic }}</view>
          <view class="info-row">当前时间: {{ currentTime }}</view>
        </view>
        <!-- 阈值报警通知（全局） -->
        <view v-if="alarmNotifications.length > 0" class="alarm-notifications">
          <view v-for="alarm in alarmNotifications" :key="alarm.id" class="alarm-card">
            <view class="alarm-card-head">
              <text class="alarm-icon">⚠</text>
              <text class="alarm-title">{{ alarm.deviceName }} - {{ alarm.displayName }} 阈值报警</text>
              <text class="alarm-close" @click="removeAlarmNotification(alarm.id)">✕</text>
            </view>
            <text class="alarm-detail">{{ alarm.message }}</text>
            <text class="alarm-time">{{ alarm.time }}</text>
          </view>
        </view>
      </view>

      <!-- 中间：图表区域 -->
      <view class="center-chart" v-if="currentMenu === 'data'">
        <view class="chart-controls">
          <picker mode="selector" :range="chartTypeOptions" @change="onChartTypeChange">
            <view class="picker">{{ chartTypeOptions[chartTypeIndex] }}</view>
          </picker>
          <picker mode="selector" :range="sensorOptions" range-key="label" @change="onSensorKeyChange">
            <view class="picker">{{ currentSensorLabel }}</view>
          </picker>
          <picker mode="selector" :range="['数字索引', '时分秒']" @change="onXAxisModeChange">
            <view class="picker">{{ xAxisMode === 'index' ? '数字索引' : '时分秒' }}</view>
          </picker>
        </view>
        <view class="chart-box" id="echartsBox"></view>
      </view>
      <view class="center-chart realtime-panel" v-else-if="currentMenu === 'realtime'">
        <!-- 左：实时数据列表 -->
        <view class="realtime-col">
          <view class="sub-title">
            <text>实时数据显示</text>
            <text class="sensor-count">（{{ realtimeDataList.length }} 个传感器）</text>
            <text :class="deviceOffline ? 'offline-tag' : 'online-tag'">{{ deviceOffline ? '（设备离线）' : '（设备在线）' }}</text>
            <view class="flag-btn" @click="openFlagDialog">标志位</view>
          </view>
          <scroll-view class="realtime-data" scroll-y>
            <view v-if="realtimeDataList.length === 0" class="empty-tip">暂无数据</view>
            <view
              v-for="(item, idx) in realtimeDataList"
              :key="idx"
              class="data-item"
              @dblclick="openRealtimeItemAction(idx)"
            >
              <text class="data-key">{{ item.displayName }}</text>
              <text class="data-value">{{ deviceOffline ? '——' : item.value }}</text>
              <text class="data-time">{{ item.time }}</text>
            </view>
          </scroll-view>
        </view>

        <!-- 右：原始JSON：单列列表 + 清空 + 分页 -->
        <view class="rawjson-col">
          <view class="sub-title raw-json-title">
            <text>原始JSON</text>
            <text class="sensor-count">（共 {{ rawJsonList.length }} 条）</text>
            <view class="raw-json-clear" @click="clearRawJson">清空</view>
          </view>
          <scroll-view class="raw-json" scroll-y>
            <view v-if="rawJsonPagedList.length === 0" class="empty-tip">暂无数据</view>
            <view v-for="(item, idx) in rawJsonPagedList" :key="idx" class="json-record" @dblclick="editRawJson(item)">
              <view class="json-time">{{ item.time }}</view>
              <view class="json-content">{{ item.json }}</view>
            </view>
          </scroll-view>

          <!-- RuoYi 风格分页 -->
          <view class="raw-json-pagination" v-if="rawJsonList.length > 0">
            <view class="pg-btn" :class="{ 'pg-disabled': rawJsonPage <= 1 }" @click="goRawJsonPage(1)"><text>首页</text></view>
            <view class="pg-btn" :class="{ 'pg-disabled': rawJsonPage <= 1 }" @click="goRawJsonPage(rawJsonPage - 1)"><text>上一页</text></view>
            <view v-for="(p, idx) in rawJsonPageList" :key="'rp' + idx" class="pg-page-item">
              <text v-if="p === -1" class="pg-ellipsis">…</text>
              <view v-else class="pg-num" :class="{ 'pg-active': p === rawJsonPage }" @click="goRawJsonPage(p)"><text>{{ p }}</text></view>
            </view>
            <view class="pg-btn" :class="{ 'pg-disabled': rawJsonPage >= rawJsonTotalPages }" @click="goRawJsonPage(rawJsonPage + 1)"><text>下一页</text></view>
            <view class="pg-btn" :class="{ 'pg-disabled': rawJsonPage >= rawJsonTotalPages }" @click="goRawJsonPage(rawJsonTotalPages)"><text>末页</text></view>
            <picker class="pg-size-picker" mode="selector" :range="rawJsonPageSizeOptions" :value="rawJsonPageSizeIndex" @change="onRawJsonPageSizeChange">
              <view class="pg-size-val"><text>{{ rawJsonPageSize }}条/页</text></view>
            </picker>
            <view class="pg-jump">
              <text>跳至</text>
              <input class="pg-jump-input" v-model="rawJsonJumpPage" type="number" placeholder="页码" />
              <text>页</text>
              <view class="pg-jump-btn" @click="onRawJsonJumpPage"><text>确定</text></view>
            </view>
          </view>
        </view>
      </view>
      <view class="center-chart" v-else-if="currentMenu === 'publish'">
        <view class="publish-form">
          <view class="publish-row">
            <text class="publish-label">HTTP：</text>
            <picker mode="selector" :range="httpMethods" @change="onHttpMethodChange" style="width:120rpx">
              <view class="picker" style="width:110rpx;text-align:center">{{ httpMethod }}</view>
            </picker>
            <input class="publish-input" v-model="httpUrl" placeholder="http://127.0.0.1:3000/api/mock-echo" />
            <view class="publish-btn report" @click="sendHttp"><text>上报</text></view>
          </view>
          <view class="publish-row">
            <text class="publish-label">数据记录：</text>
            <view class="publish-btn select" @click="showRecordDialog = true; loadSensorRecords()"><text>选择记录</text></view>
            <text v-if="selectedRecordLabel" style="font-size:22rpx;color:#667eea;margin-left:12rpx">{{ selectedRecordLabel }}</text>
          </view>
          <view class="publish-row">
            <text class="publish-label">主题：</text>
            <input class="publish-input" v-model="publishTopic" placeholder="输入发布主题" />
            <view class="publish-btn save" @click="savePublishConfig"><text>保存</text></view>
            <view class="publish-btn fill" @click="loadPublishConfig"><text>填充</text></view>
          </view>
          <view class="publish-row">
            <text class="publish-label">QoS：</text>
            <picker mode="selector" :range="qosOptions" @change="onQosChange">
              <view class="picker">{{ qosOptions[publishQos] }}</view>
            </picker>
          </view>
          <view class="publish-row">
            <text class="publish-label">格式：</text>
            <picker mode="selector" :range="payloadFormats" @change="onPayloadFormatChange">
              <view class="picker">{{ payloadFormats[payloadFormat] }}</view>
            </picker>
          </view>
          <view class="publish-row msg-row">
            <text class="publish-label">消息体：</text>
            <textarea class="publish-textarea" v-model="publishPayload" placeholder='{"key":"value"}' />
          </view>
          <view class="publish-row">
            <text class="publish-label">时间格式：</text>
            <picker mode="selector" :range="tsFormats" @change="onTsFormatChange">
              <view class="picker">{{ tsFormats[tsFormatIndex] }}</view>
            </picker>
          </view>
          <view class="publish-row">
            <text class="publish-label">时间主题：</text>
            <input class="publish-input" v-model="tsTopic" placeholder="输入发送时间戳的主题" />
          </view>
          <view class="send-row">
            <view class="publish-btn send" @click="sendPublish"><text>MQTT发送</text></view>
            <view class="publish-btn timestamp" @click="sendTimestamp"><text>发送时间戳</text></view>
          </view>
        </view>

        <!-- 选择历史记录弹窗 -->
        <view class="record-overlay" v-if="showRecordDialog" @click.self="showRecordDialog = false">
          <view class="record-dialog">
            <view class="record-dialog-title">选择数据记录</view>
            <scroll-view class="record-table" scroll-y>
              <view v-for="(r, i) in recordList" :key="i" class="record-row" :class="{checked: checkedRecords.includes(i)}" @click="toggleRecord(i)">
                <text class="record-time">{{ r.time }}</text>
                <text class="record-val">{{ JSON.stringify(r.json).substring(0, 100) }}</text>
              </view>
              <view v-if="recordList.length === 0" class="empty-tip">暂无数据</view>
            </scroll-view>
            <view class="record-actions">
              <view class="publish-btn cancel" @click="showRecordDialog = false"><text>取消</text></view>
              <view class="publish-btn confirm" @click="confirmRecords"><text>确定填充</text></view>
            </view>
          </view>
        </view>

        <view class="section-divider"></view>
        <view class="sub-title">发送记录（{{ publishHistory.length }}）</view>
        <scroll-view class="publish-history" scroll-y :scroll-top="publishScrollTop">
          <view v-if="publishHistory.length === 0" class="empty-tip">暂无记录</view>
          <view v-for="(item, idx) in publishHistory" :key="idx" class="history-item">
            <view class="history-head">
              <text class="history-time">{{ item.time }}</text>
              <text :class="item.type === 'http' ? 'http-tag' : 'mqtt-tag'">{{ item.type === 'http' ? 'HTTP' : 'MQTT' }}</text>
              <text :class="item.ok ? 'green' : 'red'">{{ item.status }}</text>
              <text class="history-topic">{{ item.topic || item.url }}</text>
            </view>
            <text class="history-payload">{{ item.payload }}</text>
            <text class="history-response" v-if="item.responseData">响应: {{ item.responseData }}</text>
          </view>
        </scroll-view>
      </view>
      <view class="center-chart switch-panel" v-else-if="currentMenu === 'switch'">
        <!-- 子标签 -->
        <view class="control-tabs">
          <view class="control-tab" :class="{ active: controlTab === 'switch' }" @click="controlTab = 'switch'">开关控制</view>
          <view class="control-tab" :class="{ active: controlTab === 'schedule' }" @click="controlTab = 'schedule'">定时任务</view>
          <view class="control-tab" :class="{ active: controlTab === 'threshold' }" @click="controlTab = 'threshold'">阈值设定</view>
          <view class="control-tab" :class="{ active: controlTab === 'theme' }" @click="controlTab = 'theme'">主题控制</view>
        </view>

        <!-- ====== 开关控制 ====== -->
        <view v-if="controlTab === 'switch'" class="control-content">
        <view class="switch-toolbar">
          <view class="toolbar-btn primary" @click="openAddSwitchForm">+ 添加开关</view>
          <view class="toolbar-btn" @click="allSwitchesOn">全部开启</view>
          <view class="toolbar-btn" @click="allSwitchesOff">全部关闭</view>
          <view class="toolbar-btn" :class="{ active: currentMode === 'auto' }" @click="switchToAuto" @dblclick="openAutoSwitchForm">自动</view>
          <view class="toolbar-btn" :class="{ active: currentMode === 'manual' }" @click="switchToManual" @dblclick="openAutoSwitchForm">手动</view>
        </view>
        <!-- 开关网格 -->
        <scroll-view class="switch-scroll" scroll-y>
          <view v-if="switches.length === 0" class="empty-tip">暂无开关，点击上方按钮添加</view>
          <view class="switch-grid">
            <view
              v-for="sw in switches"
              :key="sw.id"
              class="switch-card"
              :class="{ 'is-on': sw.isOn }"
              @dblclick="openSwitchAction(sw)"
            >
              <view class="switch-card-body">
                <text class="switch-label">{{ sw.display_name }}</text>
                <text class="switch-key-hint">{{ sw.key_name }}</text>
              </view>
              <switch
                class="switch-toggle"
                :checked="sw.isOn"
                :disabled="deviceOffline || currentMode === 'auto'"
                @change="handleSwitchToggle(sw, $event)"
              />
            </view>
            <view class="switch-card add-card" @click="openAddSwitchForm">
              <text class="add-icon">+</text>
              <text class="add-label">添加开关</text>
            </view>
          </view>
        </scroll-view>
        </view>

        <!-- ====== 定时任务 ====== -->
        <view v-else-if="controlTab === 'schedule'" class="control-content">
          <view class="switch-toolbar">
            <view class="toolbar-btn primary" @click="openAddScheduleForm">+ 添加定时</view>
          </view>
          <scroll-view class="schedule-scroll" scroll-y>
            <view v-if="schedules.length === 0" class="empty-tip">暂无定时任务，点击上方按钮添加</view>
            <view
              v-for="sch in schedules"
              :key="sch.id"
              class="schedule-item"
              @dblclick="openScheduleAction(sch)"
            >
              <view class="schedule-left">
                <text class="schedule-name">{{ sch.display_name }}</text>
                <text class="schedule-key">{{ sch.key_name }}</text>
              </view>
              <view class="schedule-center">
                <text class="schedule-time">⏰ 每 {{ sch.schedule_time }} 秒</text>
                <text class="schedule-target">{{ sch.target_state === 1 ? '定时开启' : '定时关闭' }}</text>
                <text class="schedule-countdown">{{ getScheduleCountdown(sch) }}</text>
              </view>
              <switch
                class="schedule-enable"
                :checked="sch.enabled === 1"
                @change="toggleScheduleEnabled(sch, $event)"
              />
            </view>
            <!-- 添加卡片 -->
            <view class="add-item-card" @click="openAddScheduleForm">
              <text class="add-icon">+</text>
              <text class="add-label">添加定时</text>
            </view>
          </scroll-view>
        </view>

        <!-- ====== 阈值设定 ====== -->
        <view v-else-if="controlTab === 'threshold'" class="control-content">
          <view class="switch-toolbar">
            <view class="toolbar-btn primary" @click="openAddThresholdForm">+ 添加阈值</view>
          </view>
          <scroll-view class="schedule-scroll" scroll-y>
            <view v-if="thresholds.length === 0" class="empty-tip">暂无阈值设定，点击上方按钮添加</view>
            <view
              v-for="th in thresholds"
              :key="th.id"
              class="threshold-item"
              @dblclick="openThresholdAction(th)"
            >
              <view class="threshold-main">
                <view class="threshold-header">
                  <text class="threshold-name">{{ th.display_name }}</text>
                  <text class="threshold-key">{{ th.sensor_key }}</text>
                </view>
                <view class="threshold-range">
                  <text class="range-min">Min: {{ th.min_value }}</text>
                  <text class="range-sep">—</text>
                  <text class="range-max">Max: {{ th.max_value }}</text>
                </view>
                <text v-if="th.alarm_message" class="threshold-msg">⚠ {{ th.alarm_message }}</text>
                <view v-if="th.send_to_device === 1" class="threshold-send-info">
                  <text class="send-tag">已绑定设备</text>
                  <text class="send-topic">{{ th.publish_topic }}</text>
                </view>
              </view>
              <switch
                class="threshold-enable"
                :checked="th.enabled === 1"
                @change="toggleThresholdEnabled(th, $event)"
              />
            </view>
            <!-- 添加卡片 -->
            <view class="add-item-card" @click="openAddThresholdForm">
              <text class="add-icon">+</text>
              <text class="add-label">添加阈值</text>
            </view>
          </scroll-view>
        </view>

        <!-- ====== 主题控制 ====== -->
        <view v-else class="control-content">
          <view class="switch-toolbar">
            <view class="toolbar-btn primary" @click="openAddThemeForm">+ 添加主题</view>
          </view>
          <view class="theme-nav-bar">
            <view v-for="t in themes" :key="t.id" class="theme-nav-btn"
              :class="['theme-btn-' + t.theme_code, { active: t.is_active === 1 }]"
              :style="{
                backgroundColor: t.is_active === 1 ? getThemeColor(t.theme_code) : 'transparent',
                borderColor: getThemeColor(t.theme_code),
                color: t.is_active === 1 ? '#fff' : getThemeColor(t.theme_code)
              }"
              @click="activateThemeAction(t)">
              <view class="theme-dot" :style="{ backgroundColor: getThemeColor(t.theme_code) }"></view>
              {{ getThemeLabel(t.theme_code) }}
            </view>
          </view>
          <scroll-view class="schedule-scroll" scroll-y>
            <view v-if="themes.length === 0" class="empty-tip">暂无主题，点击上方按钮添加</view>
            <view class="switch-grid">
              <view
                v-for="t in themes"
                :key="'card-' + t.id"
                class="switch-card theme-card"
                :class="{ 'is-on': t.is_active === 1 }"
                @dblclick="openThemeAction(t)"
              >
                <view class="switch-card-body">
                  <view class="theme-card-dot" :style="{ backgroundColor: getThemeColor(t.theme_code) }"></view>
                  <text class="switch-label">{{ t.display_name }}</text>
                  <text class="switch-key-hint">{{ getThemeLabel(t.theme_code) }}</text>
                  <text class="switch-key-hint">{{ t.publish_topic }}</text>
                </view>
                <view v-if="t.is_active === 1" class="theme-active-badge">
                  <text class="theme-active-text">当前</text>
                </view>
              </view>
              <view class="switch-card add-card" @click="openAddThemeForm">
                <text class="add-icon">+</text>
                <text class="add-label">添加主题</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="center-chart webview-panel" v-else-if="currentMenu === 'webview'">
        <!-- 顶部工具栏 -->
        <view class="webview-url-row">
          <text class="publish-label">网页地址：</text>
          <input class="publish-input" v-model="webviewUrlInput" placeholder="http://192.168.x.x:9000" />
          <view class="publish-btn fill" @click="handleFillWebviewUrl"><text>填充</text></view>
          <view class="publish-btn connect" :class="{ loading: webviewLoading }" @click="handleConnectWebview">
            <text>{{ webviewLoading ? '连接中...' : '连接' }}</text>
          </view>
          <view v-if="webviewConnected" class="connection-status connected">
            <view class="status-dot"></view>
            <text>已连接</text>
          </view>
        </view>

        <!-- 左右布局：WebView + 截图历史 -->
        <view class="webview-main" v-if="webviewConnected">
          <view class="webview-box">
            <web-view :src="webviewPageUrl" class="webview-webview" />
          </view>
          <view class="webview-screenshot-side" v-if="showScreenshotSidebar">
            <view class="sub-title">截图历史（{{ screenshots.length }}）</view>
            <scroll-view class="screenshot-history-list" scroll-y v-if="screenshots.length > 0">
              <view v-for="item in screenshots" :key="item.id" class="screenshot-history-item" @click="viewScreenshot(item)">
                <image
                  :src="'data:image/jpeg;base64,' + item.image_base64"
                  class="screenshot-thumb"
                  mode="aspectFill"
                />
                <view class="screenshot-info">
                  <text class="screenshot-source">{{ item.source || '截图' }}</text>
                  <text class="screenshot-time">{{ new Date(item.timestamp).toLocaleString() }}</text>
                </view>
              </view>
            </scroll-view>
            <view v-else class="empty-tip">暂无截图</view>
          </view>
        </view>

        <!-- 截图预览弹窗 -->
        <view v-if="showScreenshotPreview" class="screenshot-overlay" @click="showScreenshotPreview = false">
          <view class="screenshot-dialog" @click.stop>
            <view class="screenshot-dialog-header">
              <text class="screenshot-dialog-title">截图详情</text>
              <view class="screenshot-close" @click="showScreenshotPreview = false">×</view>
            </view>
            <view class="screenshot-dialog-body">
              <image
                v-if="screenshotPreview.image"
                :src="'data:image/jpeg;base64,' + screenshotPreview.image"
                class="screenshot-preview-image"
                mode="widthFix"
              />
              <view v-if="screenshotPreview.objects.length > 0" class="screenshot-detection-list">
                <text class="screenshot-section-title">检测目标（{{ screenshotPreview.objects.length }}）</text>
                <view v-for="(obj, idx) in screenshotPreview.objects" :key="idx" class="detection-tag">
                  <text class="detection-class">{{ obj.class }}</text>
                  <text class="detection-conf">{{ (obj.conf * 100).toFixed(1) }}%</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="center-chart query-panel" v-else-if="currentMenu === 'query'">
        <view class="query-form">
          <view class="query-row">
            <text class="query-label">数据表</text>
            <picker mode="selector" :range="queryTableNames" @change="onQueryTableChange">
              <view class="picker">{{ queryTableNames[queryTableIndex] }}</view>
            </picker>
          </view>
          <view class="query-row">
            <text class="query-label">关键词1</text>
            <picker mode="selector" :range="queryFieldLabels" @change="onQueryKeyword1FieldChange">
              <view class="picker query-field-picker">{{ queryFieldLabels[queryKeyword1Field] }}</view>
            </picker>
            <input class="query-input" v-model="queryKeyword1" placeholder="输入关键词" />
          </view>
          <view class="query-row">
            <text class="query-label">关键词2</text>
            <picker mode="selector" :range="queryFieldLabels" @change="onQueryKeyword2FieldChange">
              <view class="picker query-field-picker">{{ queryFieldLabels[queryKeyword2Field] }}</view>
            </picker>
            <input class="query-input" v-model="queryKeyword2" placeholder="可选，留空不参与查询" />
          </view>
          <view class="query-row">
            <text class="query-label">关系</text>
            <view class="segmented query-seg">
              <view class="seg-item" :class="{ active: queryKeywordOp === 0 }" @click="queryKeywordOp = 0">与 AND</view>
              <view class="seg-item" :class="{ active: queryKeywordOp === 1 }" @click="queryKeywordOp = 1">或 OR</view>
            </view>
            <text class="query-label query-label-time">匹配</text>
            <view class="segmented query-seg">
              <view class="seg-item" :class="{ active: queryExact === 0 }" @click="queryExact = 0">模糊</view>
              <view class="seg-item" :class="{ active: queryExact === 1 }" @click="queryExact = 1">精确</view>
            </view>
          </view>
          <view class="query-row" v-if="queryTableIndex === 0">
            <text class="query-label">数值范围</text>
            <input class="query-input query-num" v-model="queryValueMin" type="number" placeholder="最小值" />
            <text class="query-label query-label-time">至</text>
            <input class="query-input query-num" v-model="queryValueMax" type="number" placeholder="最大值" />
          </view>
          <view class="query-row" v-if="queryTableIndex === 4">
            <text class="query-label">类型</text>
            <picker mode="selector" :range="queryTypeLabels" @change="onQueryTypeChange">
              <view class="picker">{{ queryTypeLabels[queryTypeIndex] }}</view>
            </picker>
            <text class="query-label query-label-time">状态</text>
            <picker mode="selector" :range="queryOkLabels" @change="onQueryOkChange">
              <view class="picker">{{ queryOkLabels[queryOkIndex] }}</view>
            </picker>
          </view>
          <view class="query-row">
            <text class="query-label query-label-time">开始</text>
            <picker mode="date" :value="queryDate" @change="onQueryDateChange">
              <view class="picker">{{ queryDate || '日期' }}</view>
            </picker>
            <picker mode="multiSelector" :value="queryTimeIndex" :range="queryTimeRange" @change="onQueryTimeChange" @columnchange="onQueryTimeColumnChange">
              <view class="picker">{{ queryTime || '时间' }}</view>
            </picker>
            <text class="query-label query-label-time">结束</text>
            <picker mode="date" :value="queryEndDate" @change="onQueryEndDateChange">
              <view class="picker">{{ queryEndDate || '日期' }}</view>
            </picker>
            <picker mode="multiSelector" :value="queryEndTimeIndex" :range="queryTimeRange" @change="onQueryEndTimeChange" @columnchange="onQueryEndTimeColumnChange">
              <view class="picker">{{ queryEndTime || '时间' }}</view>
            </picker>
          </view>
          <view class="query-btn-row">
            <text class="query-sort-hint">点击列头可排序（升序/降序）</text>
            <view class="query-btn-right">
              <view class="publish-btn clear" @click="clearQuery"><text>清除</text></view>
              <view v-if="queryDone && queryResults.length > 0" class="publish-btn clear" @click="deleteAllQueryRecords"><text>删除所有内容</text></view>
              <view class="publish-btn send" @click="doQuery"><text>查询</text></view>
            </view>
          </view>
        </view>

        <view class="query-result" v-if="queryDone">
          <text class="query-total">共 {{ queryTotal }} 条</text>
          <scroll-view class="query-table-scroll" scroll-y v-if="queryResults.length > 0">
            <!-- 传感器历史表 -->
            <view class="query-table" v-if="queryTableIndex === 0">
              <view class="query-thead"><text class="th th-w80" @click="onQuerySort('id')">ID<text class="sort-icon" :class="{ 'sort-active': querySortField === 'id' }">{{ sortIcon('id') }}</text></text><text class="th" @click="onQuerySort('sensor_name')">传感器名<text class="sort-icon" :class="{ 'sort-active': querySortField === 'sensor_name' }">{{ sortIcon('sensor_name') }}</text></text><text class="th" @click="onQuerySort('display_name')">显示名称<text class="sort-icon" :class="{ 'sort-active': querySortField === 'display_name' }">{{ sortIcon('display_name') }}</text></text><text class="th" @click="onQuerySort('value')">值<text class="sort-icon" :class="{ 'sort-active': querySortField === 'value' }">{{ sortIcon('value') }}</text></text><text class="th th-w160" @click="onQuerySort('timestamp')">时间<text class="sort-icon" :class="{ 'sort-active': querySortField === 'timestamp' }">{{ sortIcon('timestamp') }}</text></text><text class="th th-w150">操作</text></view>
              <view v-for="row in queryResults" :key="row.id" class="query-tr" @dblclick="onQueryRowAction(row)">
                <text class="td th-w80">{{ row.id }}</text><text class="td">{{ row.sensor_name }}</text><text class="td">{{ row.display_name || '—' }}</text><text class="td">{{ row.value }}</text><text class="td th-w160">{{ new Date(row.timestamp).toLocaleString() }}</text>
                <view class="query-actions">
                  <text class="q-btn" @click.stop="openQueryEditDialog(row, 'sensor_history')">修改</text>
                  <text class="q-btn q-btn-del" @click.stop="confirmDeleteQueryRow(row, 'sensor_history')">删除</text>
                </view>
              </view>
            </view>
            <!-- 报警记录表（合并 alarm_history + threshold_alarms） -->
            <view class="query-table" v-else-if="queryTableIndex === 1">
              <view class="query-thead"><text class="th" @click="onQuerySort('sensor_name')">传感器名<text class="sort-icon" :class="{ 'sort-active': querySortField === 'sensor_name' }">{{ sortIcon('sensor_name') }}</text></text><text class="th th-flex" @click="onQuerySort('alarm_message')">报警消息<text class="sort-icon" :class="{ 'sort-active': querySortField === 'alarm_message' }">{{ sortIcon('alarm_message') }}</text></text><text class="th th-w160" @click="onQuerySort('timestamp')">时间<text class="sort-icon" :class="{ 'sort-active': querySortField === 'timestamp' }">{{ sortIcon('timestamp') }}</text></text><text class="th th-w150">操作</text></view>
              <view v-for="(row, idx) in queryResults" :key="idx" class="query-tr" @dblclick="onQueryRowAction(row)">
                <text class="td">{{ row.sensor_name }}</text><text class="td th-flex">{{ row.alarm_message }}</text><text class="td th-w160">{{ new Date(row.timestamp).toLocaleString() }}</text>
                <view class="query-actions">
                  <text class="q-btn" @click.stop="openQueryEditDialog(row, 'alarm_history')">修改</text>
                  <text class="q-btn q-btn-del" @click.stop="confirmDeleteQueryRow(row, 'alarm_history')">删除</text>
                </view>
              </view>
            </view>
            <!-- MQTT原始消息表 -->
            <view class="query-table" v-else-if="queryTableIndex === 2">
              <view class="query-thead"><text class="th th-w80" @click="onQuerySort('id')">ID<text class="sort-icon" :class="{ 'sort-active': querySortField === 'id' }">{{ sortIcon('id') }}</text></text><text class="th th-flex" @click="onQuerySort('json_data')">JSON数据<text class="sort-icon" :class="{ 'sort-active': querySortField === 'json_data' }">{{ sortIcon('json_data') }}</text></text><text class="th th-w160" @click="onQuerySort('timestamp_ms')">时间<text class="sort-icon" :class="{ 'sort-active': querySortField === 'timestamp_ms' }">{{ sortIcon('timestamp_ms') }}</text></text><text class="th th-w150">操作</text></view>
              <view v-for="row in queryResults" :key="row.id" class="query-tr" @dblclick="onQueryRowAction(row)">
                <text class="td th-w80">{{ row.id }}</text><text class="td th-flex json-cell">{{ row.json_data }}</text><text class="td th-w160">{{ row.time }}</text>
                <view class="query-actions">
                  <text class="q-btn" @click.stop="openQueryEditDialog(row, 'mqtt_messages')">修改</text>
                  <text class="q-btn q-btn-del" @click.stop="confirmDeleteQueryRow(row, 'mqtt_messages')">删除</text>
                </view>
              </view>
            </view>
            <!-- 截图记录表 -->
            <view class="query-table" v-else-if="queryTableIndex === 3">
              <view class="query-thead"><text class="th th-w80" @click="onQuerySort('id')">ID<text class="sort-icon" :class="{ 'sort-active': querySortField === 'id' }">{{ sortIcon('id') }}</text></text><text class="th">截图</text><text class="th" @click="onQuerySort('json_data')">检测结果<text class="sort-icon" :class="{ 'sort-active': querySortField === 'json_data' }">{{ sortIcon('json_data') }}</text></text><text class="th th-w160" @click="onQuerySort('timestamp')">时间<text class="sort-icon" :class="{ 'sort-active': querySortField === 'timestamp' }">{{ sortIcon('timestamp') }}</text></text><text class="th th-w150">操作</text></view>
              <view v-for="row in queryResults" :key="row.id" class="query-tr query-tr-img" @dblclick="onQueryRowAction(row)">
                <text class="td th-w80">{{ row.id }}</text>
                <image v-if="row.image_base64" class="td query-img" :src="'data:image/jpeg;base64,' + row.image_base64" mode="widthFix" @click="viewQueryScreenshot(row)" />
                <text v-else class="td">无</text>
                <text class="td query-json-cell">{{ row.json_data || '无' }}</text>
                <text class="td th-w160">{{ new Date(row.timestamp).toLocaleString() }}</text>
                <view class="query-actions">
                  <text class="q-btn" @click.stop="openQueryEditDialog(row, 'webview_screenshots')">修改</text>
                  <text class="q-btn q-btn-del" @click.stop="confirmDeleteQueryRow(row, 'webview_screenshots')">删除</text>
                </view>
              </view>
            </view>
            <!-- 上报记录表 -->
            <view class="query-table" v-else-if="queryTableIndex === 4">
              <view class="query-thead"><text class="th th-w60" @click="onQuerySort('type')">类型<text class="sort-icon" :class="{ 'sort-active': querySortField === 'type' }">{{ sortIcon('type') }}</text></text><text class="th">URL/主题</text><text class="th th-flex" @click="onQuerySort('payload')">发送数据<text class="sort-icon" :class="{ 'sort-active': querySortField === 'payload' }">{{ sortIcon('payload') }}</text></text><text class="th th-flex" @click="onQuerySort('response_data')">响应数据<text class="sort-icon" :class="{ 'sort-active': querySortField === 'response_data' }">{{ sortIcon('response_data') }}</text></text><text class="th th-w60" @click="onQuerySort('ok')">状态<text class="sort-icon" :class="{ 'sort-active': querySortField === 'ok' }">{{ sortIcon('ok') }}</text></text><text class="th th-w160" @click="onQuerySort('created_at')">时间<text class="sort-icon" :class="{ 'sort-active': querySortField === 'created_at' }">{{ sortIcon('created_at') }}</text></text><text class="th th-w150">操作</text></view>
              <view v-for="row in queryResults" :key="row.id" class="query-tr" @dblclick="onQueryRowAction(row)">
                <text class="td th-w60">{{ row.type }}</text>
                <text class="td">{{ row.type === 'http' ? (row.method || 'POST') + ' ' + row.url : row.topic }}</text>
                <text class="td th-flex json-cell">{{ row.payload }}</text>
                <text class="td th-flex json-cell">{{ row.response_data || '—' }}</text>
                <text class="td th-w60" :class="row.ok ? 'green' : 'red'">{{ row.ok ? 'OK' : 'FAIL' }}</text>
                <text class="td th-w160">{{ new Date(row.created_at).toLocaleString() }}</text>
                <view class="query-actions">
                  <text class="q-btn" @click.stop="openQueryEditDialog(row, 'publish_history')">修改</text>
                  <text class="q-btn q-btn-del" @click.stop="confirmDeleteQueryRow(row, 'publish_history')">删除</text>
                </view>
              </view>
            </view>
          </scroll-view>
          <view v-else class="query-empty">无匹配数据</view>
          <view class="query-pagination" v-if="queryResults.length > 0">
            <view class="pg-btn" :class="{ 'pg-disabled': queryPage <= 1 }" @click="goQueryPage(1)"><text>首页</text></view>
            <view class="pg-btn" :class="{ 'pg-disabled': queryPage <= 1 }" @click="goQueryPage(queryPage - 1)"><text>上一页</text></view>
            <view v-for="(p, idx) in queryPageList" :key="'pg' + idx" class="pg-page-item">
              <text v-if="p === -1" class="pg-ellipsis">…</text>
              <view v-else class="pg-num" :class="{ 'pg-active': p === queryPage }" @click="goQueryPage(p)"><text>{{ p }}</text></view>
            </view>
            <view class="pg-btn" :class="{ 'pg-disabled': queryPage >= queryTotalPages }" @click="goQueryPage(queryPage + 1)"><text>下一页</text></view>
            <view class="pg-btn" :class="{ 'pg-disabled': queryPage >= queryTotalPages }" @click="goQueryPage(queryTotalPages)"><text>末页</text></view>
            <picker class="pg-size-picker" mode="selector" :range="queryPageSizeOptions" :value="queryPageSizeIndex" @change="onQueryPageSizeChange">
              <view class="pg-size-val"><text>{{ queryPageSize }}条/页</text></view>
            </picker>
            <view class="pg-jump">
              <text>跳至</text>
              <input class="pg-jump-input" v-model="queryJumpPage" type="number" placeholder="页码" />
              <text>页</text>
              <view class="pg-jump-btn" @click="onQueryJumpPage"><text>确定</text></view>
            </view>
          </view>
        </view>
        <view v-else class="query-empty">选择条件后点击"查询"</view>
      </view>
      <view class="center-chart" v-else>
        <view class="placeholder">其他功能开发中</view>
      </view>

    </view>
  </view>

  <!-- 开关表单弹窗 -->
  <view v-if="showSwitchForm" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">{{ editingSwitch ? '修改开关' : '添加开关' }}</text>
        <text class="modal-close" @click="closeSwitchForm">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">键名</text>
          <input class="form-input" v-model="switchForm.keyName" placeholder="JSON键名" />
        </view>
        <view class="form-item">
          <text class="form-label">显示名字</text>
          <input class="form-input" v-model="switchForm.displayName" placeholder="展示在界面上的名字" />
        </view>
        <view class="form-item">
          <text class="form-label">发布主题</text>
          <input class="form-input" v-model="switchForm.publishTopic" placeholder="MQTT发布主题" />
        </view>
        <view class="form-item form-item-row">
          <text class="form-label">高电平点亮</text>
          <switch :checked="switchForm.activeHigh" @change="switchForm.activeHigh = !switchForm.activeHigh" />
        </view>
        <view class="form-divider"><text>响应规则（可选，解析HTTP响应自动触发）</text><text class="example-link" @click="openExample('switch')">示例</text></view>
        <view class="form-item">
          <text class="form-label">数组路径</text>
          <input class="form-input" v-model="switchForm.respArrayPath" placeholder="如: actions / dongzuo" />
        </view>
        <view class="form-item">
          <text class="form-label">目标字段</text>
          <input class="form-input" v-model="switchForm.respTargetKey" placeholder="如: target" />
        </view>
        <view class="form-item">
          <text class="form-label">命令字段</text>
          <input class="form-input" v-model="switchForm.respCommandKey" placeholder="如: command" />
        </view>
        <view class="form-item">
          <text class="form-label">映射表</text>
          <input class="form-input" v-model="switchForm.respValueMap" placeholder="如: ACTIVE=on, STOPPED=off（逗号分隔，覆盖内置）" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" @click="closeSwitchForm">取消</view>
        <view class="modal-btn confirm" @click="saveSwitch">保存</view>
      </view>
    </view>
  </view>

  <!-- 查询记录通用编辑弹窗 -->
  <view v-if="showQueryEditForm" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">修改记录</text>
        <text class="modal-close" @click="closeQueryEditForm">✕</text>
      </view>
      <view class="modal-body">
        <view v-if="queryEditError" class="form-error">{{ queryEditError }}</view>
        <view v-for="def in queryEditFieldDefs" :key="def.key" class="form-item">
          <text class="form-label">{{ def.label }}</text>
          <textarea v-if="def.type === 'textarea'" class="form-textarea" v-model="def.value" :placeholder="def.label" />
          <input v-else class="form-input" v-model="def.value" :placeholder="def.label" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" @click="closeQueryEditForm">取消</view>
        <view class="modal-btn confirm" @click="saveQueryEdit">保存</view>
      </view>
    </view>
  </view>

  <!-- 原始JSON 长按编辑弹窗 -->
  <view v-if="showRawJsonEdit" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">修改原始JSON</text>
        <text class="modal-close" @click="closeRawJsonEdit">✕</text>
      </view>
      <view class="modal-body">
        <view v-if="rawJsonEditError" class="form-error">{{ rawJsonEditError }}</view>
        <view class="form-item form-item-full">
          <text class="form-label">JSON 数据</text>
          <textarea class="form-textarea raw-json-edit-area" v-model="rawJsonEditText" placeholder="{}" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" @click="closeRawJsonEdit">取消</view>
        <view class="modal-btn confirm" @click="saveRawJsonEdit">保存</view>
      </view>
    </view>
  </view>

  <!-- 标志位设置弹窗 -->
  <view v-if="showFlagDialog" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">标志位设置</text>
        <text class="modal-close" @click="closeFlagDialog">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-item form-item-full">
          <text class="form-label">显示标志位（含此键名 → 显示在实时数据区 + 在线）</text>
          <input class="form-input" v-model="flagShowInput" placeholder="如 flag，留空则不启用" />
        </view>
        <view class="form-item form-item-full">
          <text class="form-label">隐藏标志位（含此键名 → 仅显示在原始JSON，不进实时数据区）</text>
          <input class="form-input" v-model="flagHideInput" placeholder="如 id，留空则不启用" />
        </view>
        <view class="form-item form-item-full">
          <text class="form-label">在线标志位（含此键名 → 判定设备在线，可显示在列表）</text>
          <input class="form-input" v-model="flagOnlineInput" placeholder="如 online，留空则不启用" />
        </view>
        <view class="form-item form-item-full">
          <text class="form-label">离线判定秒数（超过该秒数未收到在线标志位 → 判定离线，0=默认5秒）</text>
          <input class="form-input" v-model="offlineTimeoutInput" placeholder="如 10，留空则默认5秒" type="number" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" @click="closeFlagDialog">取消</view>
        <view class="modal-btn confirm" @click="saveFlagConfig">保存</view>
      </view>
    </view>
  </view>

  <!-- 自动开关表单弹窗 -->
  <view v-if="showAutoSwitchForm" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">自动开关配置</text>
        <text class="modal-close" @click="closeAutoSwitchForm">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-item form-item-full">
          <text class="form-label">监测键名</text>
          <input class="form-input" v-model="autoSwitchForm.keyName" placeholder="实时数据中的键名，如: mode" />
        </view>
        <view class="form-item">
          <text class="form-label">自动键值</text>
          <input class="form-input" v-model="autoSwitchForm.autoValue" placeholder="匹配为自动的键值，如: auto" />
        </view>
        <view class="form-item">
          <text class="form-label">手动键值</text>
          <input class="form-input" v-model="autoSwitchForm.manualValue" placeholder="匹配为手动的键值，如: manual" />
        </view>
        <view class="form-item">
          <text class="form-label">发布主题</text>
          <input class="form-input" v-model="autoSwitchForm.publishTopic" placeholder="发送模式指令的MQTT主题" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" @click="closeAutoSwitchForm">取消</view>
        <view class="modal-btn confirm" @click="saveAutoSwitch">保存</view>
      </view>
    </view>
  </view>

  <!-- 定时任务表单弹窗 -->
  <view v-if="showScheduleForm" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">{{ editingSchedule ? '修改定时任务' : '添加定时任务' }}</text>
        <text class="modal-close" @click="closeScheduleForm">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">键名</text>
          <input class="form-input" v-model="scheduleForm.keyName" placeholder="JSON键名" />
        </view>
        <view class="form-item">
          <text class="form-label">显示名字</text>
          <input class="form-input" v-model="scheduleForm.displayName" placeholder="展示在界面上的名字" />
        </view>
        <view class="form-item">
          <text class="form-label">发布主题</text>
          <input class="form-input" v-model="scheduleForm.publishTopic" placeholder="MQTT发布主题" />
        </view>
        <view class="form-item form-item-row">
          <text class="form-label">高电平点亮</text>
          <switch :checked="scheduleForm.activeHigh" @change="scheduleForm.activeHigh = !scheduleForm.activeHigh" />
        </view>
        <view class="form-item form-item-row">
          <text class="form-label">目标状态</text>
          <view class="segmented">
            <view class="seg-item" :class="{ active: scheduleForm.targetState === 1 }" @click="scheduleForm.targetState = 1">开启</view>
            <view class="seg-item" :class="{ active: scheduleForm.targetState === 0 }" @click="scheduleForm.targetState = 0">关闭</view>
          </view>
        </view>
        <view class="form-item form-item-row">
          <text class="form-label">间隔秒数</text>
          <input class="form-input time-input" v-model="scheduleForm.scheduleTime" placeholder="秒数，如 60" />
        </view>
        <view class="form-divider"><text>响应规则（可选，匹配到则重置倒计时）</text><text class="example-link" @click="openExample('schedule')">示例</text></view>
        <view class="form-item">
          <text class="form-label">数组路径</text>
          <input class="form-input" v-model="scheduleForm.respArrayPath" placeholder="如: actions / 留空平铺匹配" />
        </view>
        <view class="form-item">
          <text class="form-label">目标字段</text>
          <input class="form-input" v-model="scheduleForm.respTargetKey" placeholder="匹配任务键名的字段" />
        </view>
        <view class="form-item">
          <text class="form-label">命令字段</text>
          <input class="form-input" v-model="scheduleForm.respCommandKey" placeholder="如: command（可选）" />
        </view>
        <view class="form-item form-item-row">
          <text class="form-label">启用</text>
          <switch :checked="scheduleForm.enabled" @change="scheduleForm.enabled = !scheduleForm.enabled" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" @click="closeScheduleForm">取消</view>
        <view class="modal-btn confirm" @click="saveSchedule">保存</view>
      </view>
    </view>
  </view>

  <!-- 阈值设定表单弹窗 -->
  <view v-if="showThresholdForm" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">{{ editingThreshold ? '修改阈值设定' : '添加阈值设定' }}</text>
        <text class="modal-close" @click="closeThresholdForm">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">监测键名</text>
          <input class="form-input" v-model="thresholdForm.sensorKey" placeholder="订阅JSON中的键名" />
        </view>
        <view class="form-item">
          <text class="form-label">显示名字</text>
          <input class="form-input" v-model="thresholdForm.displayName" placeholder="展示在界面上的名字" />
        </view>
        <view class="form-item">
          <text class="form-label">最小值</text>
          <input class="form-input" v-model="thresholdForm.minValue" type="number" placeholder="阈值下限" />
        </view>
        <view class="form-item">
          <text class="form-label">最大值</text>
          <input class="form-input" v-model="thresholdForm.maxValue" type="number" placeholder="阈值上限" />
        </view>
        <view class="form-item">
          <text class="form-label">上限键名</text>
          <input class="form-input" v-model="thresholdForm.upperKey" placeholder="最大值对应的JSON键名" />
        </view>
        <view class="form-item">
          <text class="form-label">下限键名</text>
          <input class="form-input" v-model="thresholdForm.lowerKey" placeholder="最小值对应的JSON键名" />
        </view>
        <view class="form-item">
          <text class="form-label">触发报警消息</text>
          <input class="form-input" v-model="thresholdForm.alarmMessage" placeholder="超过阈值时发送的消息" />
        </view>
        <view class="form-item form-item-full">
          <text class="form-label">报警发送 JSON 指令</text>
          <textarea class="form-textarea" v-model="thresholdForm.alarmSendJson" auto-height placeholder='超限时发给下位机的JSON，如: {"value":1,"kaiguan":2}' />
        </view>
        <view class="form-item">
          <text class="form-label">发布主题</text>
          <input class="form-input" v-model="thresholdForm.publishTopic" placeholder="MQTT发布主题（发送阈值/报警指令共用）" />
        </view>
        <view class="form-item form-item-row">
          <text class="form-label">是否将阈值设定发送至设备</text>
          <switch :checked="thresholdForm.sendToDevice" @change="thresholdForm.sendToDevice = !thresholdForm.sendToDevice" />
        </view>
        <view class="form-divider"><text>HTTP 响应改阈值（可选，从响应取新上下限）</text><text class="example-link" @click="openExample('threshold')">示例</text></view>
        <view class="form-item">
          <text class="form-label">上限数据路径</text>
          <input class="form-input" v-model="thresholdForm.respMaxPath" placeholder="如: threshold.max" />
        </view>
        <view class="form-item">
          <text class="form-label">下限数据路径</text>
          <input class="form-input" v-model="thresholdForm.respMinPath" placeholder="如: threshold.min" />
        </view>
        <view class="form-item form-item-row">
          <text class="form-label">启用</text>
          <switch :checked="thresholdForm.enabled" @change="thresholdForm.enabled = !thresholdForm.enabled" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" @click="closeThresholdForm">取消</view>
        <view class="modal-btn confirm" @click="saveThreshold">保存</view>
      </view>
    </view>
  </view>

  <!-- 主题表单弹窗 -->
  <view v-if="showThemeForm" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">{{ editingTheme ? '修改主题' : '添加主题' }}</text>
        <text class="modal-close" @click="closeThemeForm">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">主题类型</text>
          <view class="theme-select" @click="themeDropdownOpen = !themeDropdownOpen">
            <view class="theme-select-value">
              <view class="theme-select-dot" :style="{ backgroundColor: getThemeColor(themeCodeValues[themeCodeIndex]) }"></view>
              <text>{{ themeCodeLabels[themeCodeIndex] }}</text>
            </view>
            <text class="theme-select-arrow">▾</text>
          </view>
          <view v-if="themeDropdownOpen" class="theme-dropdown">
            <view
              v-for="(label, i) in themeCodeLabels"
              :key="themeCodeValues[i]"
              class="theme-dropdown-item"
              :class="{ active: i === themeCodeIndex }"
              @click="selectThemeCode(i)"
            >
              <view class="theme-select-dot" :style="{ backgroundColor: getThemeColor(themeCodeValues[i]) }"></view>
              <text>{{ label }}</text>
            </view>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">显示名字</text>
          <input class="form-input" v-model="themeForm.displayName" placeholder="如: 正常运行模式" />
        </view>
        <view class="form-divider"><text>HTTP 响应匹配规则</text><text class="example-link" @click="openExample('theme')">示例</text></view>
        <view class="form-item">
          <text class="form-label">响应字段路径</text>
          <input class="form-input" v-model="themeForm.httpKeyName" placeholder="如: status" />
        </view>
        <view class="form-item">
          <text class="form-label">触发值</text>
          <input class="form-input" v-model="themeForm.httpKeyValue" placeholder="如: warning" />
        </view>
        <view class="form-divider"><text>MQTT 下发配置</text></view>
        <view class="form-item">
          <text class="form-label">MQTT 键名</text>
          <input class="form-input" v-model="themeForm.mqttKeyName" placeholder="MQTT key name" />
        </view>
        <view class="form-item">
          <text class="form-label">MQTT 键值</text>
          <input class="form-input" v-model="themeForm.mqttKeyValue" placeholder="MQTT value" />
        </view>
        <view class="form-item">
          <text class="form-label">发布主题</text>
          <input class="form-input" v-model="themeForm.publishTopic" placeholder="MQTT发布主题" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" @click="closeThemeForm">取消</view>
        <view class="modal-btn confirm" @click="saveTheme">保存</view>
      </view>
    </view>
  </view>

  <!-- 示例 JSON 弹窗 -->
  <view v-if="showExample" class="modal-overlay">
    <view class="modal-card" @click.stop>
      <view class="modal-header">
        <text class="modal-title">{{ exampleTitle }}</text>
        <text class="modal-close" @click="showExample = false">✕</text>
      </view>
      <view class="modal-body">
        <rich-text :nodes="exampleHtml"></rich-text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted, onUnmounted, watch, nextTick } from 'vue'
import { request, getSensorHistory, getSpecialData, getSensorDisplayNames, updateSensorDisplayName, getSwitchConfigs, createSwitchConfig, updateSwitchConfig, deleteSwitchConfig, updateSwitchState, getAutoSwitchConfig, saveAutoSwitchConfig, updateAutoSwitchMode, getScheduleConfigs, createScheduleConfig, updateScheduleConfig, deleteScheduleConfig, executeSchedule, getThresholdConfigs, createThresholdConfig, updateThresholdConfig, deleteThresholdConfig, recordAlarm, getWebviewConfig, saveWebviewConfig, getWebviewScreenshots, saveSensorData, queryData, updateQueryRecord, deleteQueryRecord, deleteQueryRecords, getThemeConfigs, createThemeConfig, updateThemeConfig, deleteThemeConfig, activateTheme, getFlagConfig, saveFlagConfig as saveFlagConfigApi } from '@/utils/api'
import { getBackendHost, BACKEND_PORT } from '@/utils/config'
import * as echarts from 'echarts'
import mqtt from 'paho-mqtt'
import { alarmNotifications, addAlarmNotification, removeAlarmNotification } from '@/hooks/useAlarmCenter'

// ---------- 页面参数 ----------
const props = defineProps<{
  deviceId: string
  name: string
  type: string
}>()
const deviceId = ref(props.deviceId)
const deviceName = ref(decodeURIComponent(props.name || '未知设备'))
const deviceType = ref(props.type || 'normal')

// ---------- 左侧数据 ----------
const menus = [
  { label: '数据可视化', value: 'data' },
  { label: '数据一览', value: 'realtime' },
  { label: '发布消息', value: 'publish' },
  { label: '设备控制', value: 'switch' },
  { label: '监控设备', value: 'webview' },
  { label: '数据查询', value: 'query' }
]
const currentMenu = ref('data')
const port = ref('')
const topic = ref('')
const currentTime = ref('')

const updateCurrentTime = () => {
  const now = new Date()
  currentTime.value = `${now.getFullYear()}-${(now.getMonth()+1).toString().padStart(2,'0')}-${now.getDate().toString().padStart(2,'0')} ${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}:${now.getSeconds().toString().padStart(2,'0')}`
}

// 加载订阅信息
const brokerHost = ref('127.0.0.1')
const loadSubscription = async () => {
  try {
    const res = await request({ url: '/mqtt-configs', method: 'GET' })
    if (res.data.code === 200 && res.data.data.length) {
      const cfg = res.data.data[0]
      port.value = cfg.port
      topic.value = cfg.topic
      if (cfg.broker_url) {
        try {
          let urlStr = cfg.broker_url
          // 补全协议前缀
          if (!/^https?:\/\//i.test(urlStr) && !/^mqtt:\/\//i.test(urlStr) && !/^tcp:\/\//i.test(urlStr)) {
            urlStr = 'tcp://' + urlStr
          }
          // 移除协议前缀后提取 hostname
          const hostMatch = urlStr.match(/^(?:[a-z]+:\/\/)?([^:/]+)/i)
          if (hostMatch) brokerHost.value = hostMatch[1]
        } catch(e) {}
      }
    }
    // 优先使用首页当前订阅的 broker（用户在首页连哪个，开关就发哪个）
    const activeHost = uni.getStorageSync('activeBrokerHost')
    if (activeHost) brokerHost.value = activeHost
    const activePort = uni.getStorageSync('activeBrokerPort')
    if (activePort) port.value = activePort
    const activeTopic = uni.getStorageSync('activeBrokerTopic')
    if (activeTopic) topic.value = activeTopic
  } catch(e) { console.error(e) }
}

// ---------- 传感器显示名称 ----------
const sensorDisplayNames = ref({})
const loadSensorDisplayNames = async () => {
  try {
    const map = await getSensorDisplayNames(deviceId.value)
    sensorDisplayNames.value = map
  } catch(e) { console.error(e) }
}

// ---------- 图表相关 (ECharts) ----------
const chartTypeOptions = ref(['曲线图', '折线图', '柱状图', '饼图'])
const chartTypeIndex = ref(0)
const sensorOptions = ref([])
const ALL_SENSOR_KEY = '__all__'
const selectedSensorKey = ref(ALL_SENSOR_KEY)
const xAxisMode = ref('index')
let chartInstance = null
let resizeHandler = null
const currentSensorLabel = ref('请选择')
const historyRecords = ref([])
let visibleStartPct = 0
let visibleEndPct = 100

const isControlKey = (k: string) => /^key\d+$/i.test(k)

// 自适应 Y 轴：略大于数据最大值，并对齐到整齐刻度（1/1.5/2/2.5/3/4/5/7.5/10 的数量级）
// 例如数据最大 25 → 轴顶 30；数据最大 5.2 → 轴顶 7.5；数据最大 120 → 轴顶 150
const yAxisMax = (maxVal: number): number => {
  if (isNaN(maxVal) || !isFinite(maxVal) || maxVal <= 0) return 10
  const target = maxVal * 1.15
  const magnitude = Math.pow(10, Math.floor(Math.log10(target)))
  const normalized = target / magnitude
  const niceSteps = [1, 1.5, 2, 2.5, 3, 4, 5, 7.5, 10]
  let chosen = 10
  for (const s of niceSteps) {
    if (normalized <= s) { chosen = s; break }
  }
  return chosen * magnitude
}

const rebuildSensorOptions = () => {
  if (!historyRecords.value.length) return
  const allKeys = new Set()
  historyRecords.value.forEach(rec => Object.keys(rec.values).forEach(k => allKeys.add(k)))
  const keysList = Array.from(allKeys).sort().filter(k => {
    if (isControlKey(k)) return false
    if (isFlagKey(k)) return false
    return historyRecords.value.some(rec => {
      const v = rec.values[k]
      return v !== null && v !== undefined && !isNaN(Number(v))
    })
  })
  const opts = [{ value: ALL_SENSOR_KEY, label: '全部' }]
  for (const key of keysList) {
    const display = sensorDisplayNames.value[key] || key
    opts.push({ value: key, label: display })
  }
  sensorOptions.value = opts
  if (selectedSensorKey.value !== ALL_SENSOR_KEY && !keysList.includes(selectedSensorKey.value)) {
    selectedSensorKey.value = ALL_SENSOR_KEY
  }
  updateCurrentSensorLabel()
}

const updateCurrentSensorLabel = () => {
  const found = sensorOptions.value.find(opt => opt.value === selectedSensorKey.value)
  currentSensorLabel.value = found ? found.label : (selectedSensorKey.value || '请选择')
}

const buildEchartsOption = () => {
  const chartType = chartTypeIndex.value

  // ---------- 饼图 ----------
  if (chartType === 3) {
    if (historyRecords.value.length === 0) return null
    const latest = historyRecords.value[historyRecords.value.length - 1]
    const pieData = Object.entries(latest.values)
      .filter(([k, v]) => !isControlKey(k) && !isFlagKey(k) && v !== null && v !== undefined && !isNaN(Number(v)))
      .map(([k, v]) => ({ name: sensorDisplayNames.value[k] || k, value: Number(v) }))
    if (pieData.length === 0) return null
    const total = pieData.reduce((sum, d) => sum + d.value, 0)
    const timeStr = new Date(latest.timestamp).toLocaleTimeString()
    return {
      title: {
        text: timeStr,
        subtext: `${pieData.length} 个传感器`,
        left: 'center',
        top: 'center',
        textStyle: { fontSize: 13, color: '#333', fontWeight: 'bold' },
        subtextStyle: { fontSize: 11, color: '#999' }
      },
      tooltip: {
        trigger: 'item',
        backgroundColor: 'rgba(51,51,51,0.92)',
        borderColor: '#007aff',
        borderWidth: 1,
        textStyle: { color: '#fff', fontSize: 11 },
        formatter: (p: any) => `${p.marker} ${p.name}: ${p.value} (${p.percent}%)`
      },
      legend: {
        bottom: 0,
        textStyle: { fontSize: 10, color: '#666' },
        itemWidth: 10,
        itemHeight: 10
      },
      series: [{
        type: 'pie',
        radius: ['45%', '68%'],
        center: ['50%', '48%'],
        data: pieData,
        label: {
          fontSize: 10,
          color: '#666',
          formatter: '{b}\n{d}%'
        },
        labelLine: { length: 16, length2: 10 },
        itemStyle: { borderRadius: 3, borderColor: '#fff', borderWidth: 2 },
        emphasis: {
          label: { fontSize: 14, fontWeight: 'bold' },
          scaleSize: 8
        }
      }]
    }
  }

  // ---------- 折线图 / 曲线图 / 柱状图 ----------
  const isBar = chartType === 2
  const isCurve = chartType === 0
  const palette = ['#007aff', '#ff5722', '#4caf50', '#ff9800', '#9c27b0', '#00bcd4', '#e91e63', '#795548', '#3f51b5', '#607d8b']

  const buildSeries = (name: string, yData: any[], color: string, opts: any = {}) => {
    const cfg: any = {
      name,
      type: isBar ? 'bar' : 'line',
      data: yData
    }
    if (isBar) {
      cfg.barMaxWidth = opts.dense ? 28 : 56
      cfg.barMinWidth = 3
      cfg.barCategoryGap = '30%'
      cfg.barGap = '15%'
      cfg.itemStyle = { color, borderRadius: [3, 3, 0, 0] }
      cfg.label = {
        show: true, position: 'top', distance: 6, fontSize: 10, color: '#555',
        formatter: (p: any) => (p.value === null || p.value === undefined || isNaN(p.value)) ? '' : p.value
      }
    } else {
      if (isCurve) cfg.smooth = true
      cfg.symbol = 'circle'
      cfg.symbolSize = opts.dense ? 6 : 7
      cfg.showSymbol = true
      cfg.lineStyle = { color: color, width: 2 }
      cfg.connectNulls = true
      cfg.label = { show: false }
      if (opts.withArea) {
        cfg.areaStyle = {
          color: {
            type: 'linear', x: 0, y: 0, x2: 0, y2: 1,
            colorStops: [
              { offset: 0, color: 'rgba(0,122,255,0.20)' },
              { offset: 1, color: 'rgba(0,122,255,0.01)' }
            ]
          }
        }
      }
    }
    if (opts.dense) cfg.emphasis = { focus: 'series' }
    return cfg
  }

  const buildZoom = (len: number) => [{
    type: 'inside',
    start: Math.max(0, 100 - (10 / len) * 100),
    end: 100,
    minSpan: Math.max(0.2, (3 / len) * 100)
  }, {
    type: 'slider',
    start: Math.max(0, 100 - (10 / len) * 100),
    end: 100,
    height: 20,
    bottom: 4,
    borderColor: '#eee',
    fillerColor: 'rgba(0,122,255,0.1)',
    handleStyle: { color: '#007aff' }
  }]

  // ---------- 选「全部」：多系列 ----------
  if (selectedSensorKey.value === ALL_SENSOR_KEY) {
    const keys = sensorOptions.value.filter(o => o.value !== ALL_SENSOR_KEY).map(o => o.value)
    if (keys.length === 0 || historyRecords.value.length === 0) return null

    let xData = []
    if (xAxisMode.value === 'index') {
      xData = historyRecords.value.map((_, idx) => (idx + 1).toString())
    } else {
      xData = historyRecords.value.map(rec => new Date(rec.timestamp).toLocaleTimeString())
    }

    const series = keys.map((k, i) => {
      const name = sensorDisplayNames.value[k] || k
      const yData = historyRecords.value.map(rec => {
        const v = rec.values[k]
        return (v === null || v === undefined || isNaN(Number(v))) ? null : Number(v)
      })
      return buildSeries(name, yData, palette[i % palette.length], { dense: true })
    })

    // Y 轴只根据当前可见（缩放窗口内）的数据计算，避免历史离群值撑高轴
    const totalLen = historyRecords.value.length
    const si = Math.floor(visibleStartPct / 100 * totalLen)
    const ei = Math.min(totalLen - 1, Math.ceil(visibleEndPct / 100 * totalLen))
    const visibleVals: number[] = []
    for (const s of series) {
      for (let i = si; i <= ei && i < s.data.length; i++) {
        const v = s.data[i]
        if (v !== null && v !== undefined && !isNaN(Number(v))) visibleVals.push(Number(v))
      }
    }
    const yMax = visibleVals.length ? yAxisMax(Math.max(...visibleVals)) : 10

    return {
      grid: { left: 48, right: 20, top: 56, bottom: 40 },
      legend: {
        top: 0,
        type: 'scroll',
        textStyle: { fontSize: 10, color: '#666' },
        itemWidth: 10,
        itemHeight: 10
      },
      xAxis: {
        type: 'category',
        data: xData,
        boundaryGap: isBar,
        axisLine: { lineStyle: { color: '#ddd' } },
        axisLabel: { color: '#999', fontSize: 10 }
      },
      yAxis: {
        type: 'value',
        max: yMax,
        splitLine: { lineStyle: { color: '#f0f0f0' } },
        axisLabel: { color: '#999', fontSize: 10 }
      },
      tooltip: {
        trigger: 'axis',
        axisPointer: { type: 'cross', label: { backgroundColor: '#6a7985' } },
        backgroundColor: 'rgba(51,51,51,0.92)',
        borderColor: '#007aff',
        borderWidth: 1,
        textStyle: { color: '#fff', fontSize: 11 }
      },
      dataZoom: buildZoom(historyRecords.value.length),
      series
    }
  }

  // ---------- 选单个传感器：保持原单条蓝色 ----------
  const key = selectedSensorKey.value
  if (!key || historyRecords.value.length === 0) return null

  const filtered = historyRecords.value.filter(rec => rec.values.hasOwnProperty(key))
  if (filtered.length === 0) return null

  let xData = []
  if (xAxisMode.value === 'index') {
    xData = filtered.map((_, idx) => (idx + 1).toString())
  } else {
    xData = filtered.map(rec => new Date(rec.timestamp).toLocaleTimeString())
  }
  const yData = filtered.map(rec => Number(rec.values[key]))
  const seriesName = sensorDisplayNames.value[key] || key

  // Y 轴只根据当前可见（缩放窗口内）的数据计算
  const totalLen = filtered.length
  const si = Math.floor(visibleStartPct / 100 * totalLen)
  const ei = Math.min(totalLen - 1, Math.ceil(visibleEndPct / 100 * totalLen))
  const visibleVals: number[] = []
  for (let i = si; i <= ei; i++) {
    const v = yData[i]
    if (v !== null && v !== undefined && !isNaN(Number(v))) visibleVals.push(Number(v))
  }
  const yMax = visibleVals.length ? yAxisMax(Math.max(...visibleVals)) : 10

  return {
    grid: { left: 40, right: 20, top: 40, bottom: 40 },
    xAxis: {
      type: 'category',
      data: xData,
      boundaryGap: isBar,
      axisLine: { lineStyle: { color: '#ddd' } },
      axisLabel: { color: '#999', fontSize: 10 }
    },
    yAxis: {
      type: 'value',
      max: yMax,
      splitLine: { lineStyle: { color: '#f0f0f0' } },
      axisLabel: { color: '#999', fontSize: 10 }
    },
    tooltip: {
      trigger: 'axis',
      backgroundColor: 'rgba(51,51,51,0.92)',
      borderColor: '#007aff',
      borderWidth: 1,
      textStyle: { color: '#fff', fontSize: 11 },
      formatter: (params) => {
        const p = params[0]
        const rec = filtered[p.dataIndex]
        const lines = [`${seriesName}: ${p.value}`]
        for (const [k, v] of Object.entries(rec.values)) {
          if (k === key || k === '传感器' || isControlKey(k) || isFlagKey(k)) continue
          const label = sensorDisplayNames.value[k] || k
          const dv = typeof v === 'object' ? JSON.stringify(v) : v
          lines.push(`${label}: ${dv}`)
        }
        return lines.join('\n')
      }
    },
    dataZoom: buildZoom(filtered.length),
    series: [buildSeries(seriesName, yData, '#007aff', { withArea: true })]
  }
}

const renderChart = () => {
  // 全量重绘时，把可见范围重置为 dataZoom 默认窗口（最后约 7 条）
  const totalLen = (selectedSensorKey.value === ALL_SENSOR_KEY)
    ? historyRecords.value.length
    : historyRecords.value.filter(rec => rec.values.hasOwnProperty(selectedSensorKey.value)).length
  visibleStartPct = totalLen > 0 ? Math.max(0, 100 - (10 / totalLen) * 100) : 0
  visibleEndPct = 100

  const option = buildEchartsOption()
  if (!option) {
    if (chartInstance) chartInstance.setOption({ series: [] }, true)
    return
  }
  if (!chartInstance) {
    const dom = document.getElementById('echartsBox')
    if (!dom) return
    chartInstance = echarts.init(dom)
    if (!resizeHandler) {
      resizeHandler = () => { if (chartInstance) chartInstance.resize() }
      window.addEventListener('resize', resizeHandler)
    }
  }
  chartInstance.setOption(option, true)

  // dataZoom 事件：用户缩放/拖动时，Y 轴跟随可见数据范围自适应
  chartInstance.off('datazoom')
  chartInstance.on('datazoom', () => {
    if (!chartInstance) return
    const opt: any = chartInstance.getOption()
    if (opt.dataZoom && opt.dataZoom[0]) {
      visibleStartPct = opt.dataZoom[0].start
      visibleEndPct = opt.dataZoom[0].end
      const newOpt = buildEchartsOption()
      if (newOpt && newOpt.yAxis) {
        chartInstance.setOption({ yAxis: { max: newOpt.yAxis.max } })
      }
    }
  })
}

const initChart = () => {
  const dom = document.getElementById('echartsBox')
  if (!dom) { setTimeout(initChart, 200); return }
  if (!chartInstance) {
    chartInstance = echarts.init(dom)
    if (!resizeHandler) {
      resizeHandler = () => { if (chartInstance) chartInstance.resize() }
      window.addEventListener('resize', resizeHandler)
    }
  }
  renderChart()
}

// ---------- 加载历史数据 ----------
let lastHistoryTs = 0
let rawJsonPushedTs = 0
const loadHistoryData = async () => {
  try {
    let records
    if (deviceType.value === 'special') {
      records = await getSpecialData(deviceId.value)
    } else {
      records = await getSensorHistory(deviceId.value)
    }
    const allRecords = []
    if (deviceType.value === 'special') {
      for (let rec of records) {
        const json = JSON.parse(rec.json_data)
        const values = {}
        for (const [k, v] of Object.entries(json)) values[k] = v
        allRecords.push({ timestamp: rec.timestamp, values, id: rec.id })
      }
    } else {
      const map = new Map()
      for (let rec of records) {
        if (!map.has(rec.timestamp)) map.set(rec.timestamp, {})
        map.get(rec.timestamp)[rec.sensor_name] = rec.value
      }
      for (let [ts, values] of map.entries()) allRecords.push({ timestamp: ts, values })
    }
    allRecords.sort((a,b) => a.timestamp - b.timestamp)
    // 只取上次加载之后的新记录
    const newRecords = lastHistoryTs === 0 ? allRecords : allRecords.filter(r => r.timestamp > lastHistoryTs)
    if (newRecords.length > 0) {
      lastHistoryTs = newRecords[newRecords.length - 1].timestamp
      if (lastHistoryTs === 0) {
        // 首次加载：完整替换
        historyRecords.value = newRecords
      } else {
        // 后续加载：追加新记录
        historyRecords.value = [...historyRecords.value, ...newRecords]
      }
      rebuildSensorOptions()
      // 只有存在非隐藏记录时才标记在线；隐藏标志位命中的消息不驱动在线
      const visibleRecords = newRecords.filter((r) => !isHiddenMessage(r.values))
      if (visibleRecords.length > 0) {
        markDataReceived(visibleRecords[visibleRecords.length - 1].timestamp)
      }
      console.log('[loadHistoryData] newRecords=', newRecords.length, '条, 调用 updateRealtimeAndRaw')
      updateRealtimeAndRaw(newRecords)
      checkThresholds()
      nextTick(() => renderChart())
    }
  } catch(e) { console.error(e) }
}

// 实时数据：累加不覆盖，所有出现过的键名都保留
// 统一去除尾部数字作为键名（temperature1 → temperature），避免与历史数据重复
const stripTrailingNum = (s: string) => s.replace(/\d+$/, '')

// 离线判定：默认 5 秒内未收到新数据即视为离线，离线时保留键名、值显示「——」
// 若配置了在线标志位，则改为「最近一次收到在线标志位的时间」超过离线判定秒数才算离线
let lastDataReceivedAt = 0
let lastOnlineFlagAt = 0
const deviceOffline = ref(false)
let offlineTimer = null
const offlineTimeoutMs = (): number => {
  const sec = offlineTimeoutSeconds.value > 0 ? offlineTimeoutSeconds.value : 5
  return sec * 1000
}
const markDataReceived = (ts?: number) => {
  lastDataReceivedAt = (typeof ts === 'number' && ts > 0) ? ts : Date.now()
  // 配置了在线标志位时，普通数据不再直接决定在线状态，交给 startOfflineWatch 用在线标志位时间判断
  if (flagOnlineKey.value.trim() !== '') return
  deviceOffline.value = (Date.now() - lastDataReceivedAt) >= 5000
}
const startOfflineWatch = () => {
  if (offlineTimer) clearInterval(offlineTimer)
  offlineTimer = setInterval(() => {
    const onlineKey = flagOnlineKey.value.trim()
    if (onlineKey !== '') {
      // 用在线标志位判定：从未收到 → 离线；超过离线判定秒数未收到 → 离线；否则在线
      deviceOffline.value = !lastOnlineFlagAt || (Date.now() - lastOnlineFlagAt) >= offlineTimeoutMs()
    } else {
      if (!lastDataReceivedAt || Date.now() - lastDataReceivedAt >= 5000) deviceOffline.value = true
    }
  }, 1000)
}

// 标志位配置：显示标志位（命中→显示+在线）、隐藏标志位（命中→仅原始JSON，不进实时数据区）、在线标志位（命中→在线判定依据）
const flagShowKey = ref('')
const flagHideKey = ref('')
const flagOnlineKey = ref('')
const offlineTimeoutSeconds = ref(0)
const showFlagDialog = ref(false)
const flagShowInput = ref('')
const flagHideInput = ref('')
const flagOnlineInput = ref('')
const offlineTimeoutInput = ref('')
const loadFlagConfig = async () => {
  try {
    const data = await getFlagConfig(deviceId.value)
    if (data) {
      flagShowKey.value = data.show || ''
      flagHideKey.value = data.hide || ''
      flagOnlineKey.value = data.online || ''
      offlineTimeoutSeconds.value = Number(data.offlineTimeout) || 0
      try {
        uni.setStorageSync('flagConfig_' + deviceId.value, { show: flagShowKey.value, hide: flagHideKey.value, online: flagOnlineKey.value, offlineTimeout: offlineTimeoutSeconds.value })
      } catch (e) {}
    }
  } catch (e) {
    // 后端不可用时回退本地缓存
    try {
      const saved = uni.getStorageSync('flagConfig_' + deviceId.value)
      if (saved) {
        flagShowKey.value = saved.show || ''
        flagHideKey.value = saved.hide || ''
        flagOnlineKey.value = saved.online || ''
        offlineTimeoutSeconds.value = Number(saved.offlineTimeout) || 0
      } else {
        flagShowKey.value = ''
        flagHideKey.value = ''
        flagOnlineKey.value = ''
        offlineTimeoutSeconds.value = 0
      }
    } catch (e2) {}
  }
}
const openFlagDialog = () => {
  flagShowInput.value = flagShowKey.value
  flagHideInput.value = flagHideKey.value
  flagOnlineInput.value = flagOnlineKey.value
  offlineTimeoutInput.value = offlineTimeoutSeconds.value > 0 ? String(offlineTimeoutSeconds.value) : ''
  showFlagDialog.value = true
}
const closeFlagDialog = () => {
  showFlagDialog.value = false
}
const saveFlagConfig = () => {
  flagShowKey.value = flagShowInput.value.trim()
  flagHideKey.value = flagHideInput.value.trim()
  flagOnlineKey.value = flagOnlineInput.value.trim()
  offlineTimeoutSeconds.value = Number(offlineTimeoutInput.value.trim()) || 0
  // 本地缓存兜底
  try {
    uni.setStorageSync('flagConfig_' + deviceId.value, { show: flagShowKey.value, hide: flagHideKey.value, online: flagOnlineKey.value, offlineTimeout: offlineTimeoutSeconds.value })
  } catch (e) {}
  // 持久化到后端数据库
  saveFlagConfigApi(deviceId.value, flagShowKey.value, flagHideKey.value, flagOnlineKey.value, offlineTimeoutSeconds.value).catch(() => {})
  showFlagDialog.value = false
  uni.showToast({ title: '标志位已保存', icon: 'success' })
}

// 标志位匹配：统一去掉键名末尾的「_数字」后缀（含「_」本身）再比较，兼容 id_1（原始上报）与 id_（后端存储）两种格式
const normFlagKey = (s: string) => s.replace(/_\d*$/, '')
// 判断一条数据是否命中「隐藏标志位」：含隐藏键且不含显示键 → 不进实时数据区（原始JSON仍显示）
const isHiddenMessage = (values: Record<string, any>): boolean => {
  const hideKey = flagHideKey.value.trim()
  const showKey = flagShowKey.value.trim()
  if (hideKey === '') return false
  const keys = Object.keys(values)
  const hasHide = keys.some((k: string) => normFlagKey(k) === normFlagKey(hideKey))
  const hasShow = showKey !== '' && keys.some((k: string) => normFlagKey(k) === normFlagKey(showKey))
  return hasHide && !hasShow
}
// 判断一个键名是否为标志位（显示/隐藏标志）。标志位仅作信号，不作为传感器展示
const isFlagKey = (k: string): boolean => {
  const n = normFlagKey(k)
  const showKey = flagShowKey.value.trim()
  const hideKey = flagHideKey.value.trim()
  if (showKey !== '' && n === normFlagKey(showKey)) return true
  if (hideKey !== '' && n === normFlagKey(hideKey)) return true
  return false
}
// 判断一条数据是否命中「在线标志位」键名。在线标志位可显示在列表中，仅作在线判定信号
const hasOnlineFlag = (values: Record<string, any>): boolean => {
  const onlineKey = flagOnlineKey.value.trim()
  if (onlineKey === '') return false
  return Object.keys(values).some((k: string) => normFlagKey(k) === normFlagKey(onlineKey))
}

const realtimeDataMap = ref<Record<string, {key:string,value:any,time:string,displayName:string}>>({})
// 用户手动「删除」的传感器键名（仅隐藏显示，不删除历史数据，重新进入页面后恢复）
const hiddenSensorKeys = ref<string[]>([])

const updateRealtimeAndRaw = (newRecords) => {
  const records = newRecords || historyRecords.value
  if (records.length === 0) {
    rawJsonList.value = []
    return
  }
  // 只遍历本次新增记录，累积每个传感器的最新值（避免历史旧值覆盖实时数据）
  const map = { ...realtimeDataMap.value }
  const isSpecial = deviceType.value === 'special'
  const currentKeys: string[] = []
  for (const rec of records) {
    // 在线标志位命中 → 更新最近一次在线时间（历史回放用，驱动在线判定）
    if (hasOnlineFlag(rec.values)) {
      const t = (typeof rec.timestamp === 'number' && rec.timestamp > 0) ? rec.timestamp : Date.now()
      if (t > lastOnlineFlagAt) lastOnlineFlagAt = t
    }
    // 隐藏标志位命中的记录不进实时数据区（原始JSON仍会推送）
    if (isHiddenMessage(rec.values)) continue
    for (const [key, val] of Object.entries(rec.values)) {
      const normalized = isSpecial ? key : stripTrailingNum(key)
      // 标志位键名仅作信号，不作为传感器展示
      if (isFlagKey(normalized)) continue
      currentKeys.push(normalized)
      const display = sensorDisplayNames.value[key] || sensorDisplayNames.value[normalized] || normalized
      const displayValue = typeof val === 'object' ? JSON.stringify(val) : val
      map[normalized] = { key: normalized, value: displayValue, time: new Date(rec.timestamp).toLocaleTimeString(), displayName: display }
    }
  }
  // 新数据到达的键名自动从「隐藏」中移除，重新显示
  if (currentKeys.length > 0) {
    const keySet = new Set(currentKeys)
    hiddenSensorKeys.value = hiddenSensorKeys.value.filter((k: string) => !keySet.has(k))
  }
  realtimeDataMap.value = map
  realtimeDataList.value = Object.values(map).filter((item: any) => !hiddenSensorKeys.value.includes(item.key))
  // 根据最新历史数据回显开关状态（下位机上报的 0/1 驱动开关显示）
  const latestRec = records[records.length - 1]
  if (latestRec) updateSwitchStates(latestRec.values)
  // 更新自动/手动模式
  updateAutoMode()
  // 原始JSON：只追加上次推送之后的新记录
  console.log('[updateRealtimeAndRaw] records共', records.length, '条, rawJsonPushedTs=', rawJsonPushedTs, 'rawJsonList已有', rawJsonList.value.length, '条')
  for (const rec of records) {
    if (rec.timestamp > rawJsonPushedTs) {
      const content = JSON.stringify(rec.values, Object.keys(rec.values).sort(), 2)
      console.log('[updateRealtimeAndRaw] 推送 ts=', rec.timestamp, '> rawJsonPushedTs=', rawJsonPushedTs)
      pushRawJson({
        time: new Date(rec.timestamp).toLocaleString(),
        json: content,
        src: isSpecial
          ? { table: 'special_data', id: rec.id }
          : { table: 'sensor_history', timestamp: rec.timestamp }
      })
      rawJsonPushedTs = rec.timestamp
    } else {
      console.log('[updateRealtimeAndRaw] 跳过 ts=', rec.timestamp, '<= rawJsonPushedTs=', rawJsonPushedTs)
    }
  }
  nextTick(() => { rawJsonScrollTop.value = rawJsonScrollTop.value + 1 + 99999 })
}

// 直接处理MQTT消息，实时更新实时数据
const handleRealtimeMqttMessage = (payloadStr: string) => {
  try {
    const json = JSON.parse(payloadStr)
    const isSpecial = deviceType.value === 'special'
    const now = Date.now()
    const keys = Object.keys(json)
    matchThemeFromMqtt(json, keys)
    runScheduleResponse(json)

    // 标志位判断：隐藏标志位命中→不进实时数据区（只进原始JSON）；显示标志位命中→显示+在线
    const shouldHideRealtime = isHiddenMessage(json)

    // 在线标志位命中 → 立即判定在线并重置离线计时
    if (hasOnlineFlag(json)) {
      lastOnlineFlagAt = now
      deviceOffline.value = false
    }

    if (!shouldHideRealtime) {
      const map = { ...realtimeDataMap.value }
      const currentKeys: string[] = []
      for (const [key, val] of Object.entries(json)) {
        // 普通设备：按数字后缀过滤，只显示匹配当前设备ID的数据
        if (!isSpecial) {
          const deviceIdFromKey = parseInt((key.match(/(\d+)$/) || [''])[0], 10)
          if (!deviceIdFromKey || deviceIdFromKey !== parseInt(deviceId.value)) continue
        }
        // 特殊设备保留原始key不去尾数，避免"temp1"和"temp"去尾后冲突
        const sensorName = isSpecial ? key : stripTrailingNum(key)
        // 标志位键名仅作信号，不作为传感器展示
        if (isFlagKey(sensorName)) continue
        currentKeys.push(sensorName)
        const display = sensorDisplayNames.value[key] || sensorDisplayNames.value[sensorName] || sensorName
        const displayValue = typeof val === 'object' ? JSON.stringify(val) : val
        map[sensorName] = { key: sensorName, value: displayValue, time: new Date(now).toLocaleTimeString(), displayName: display }
      }
      // 新数据到达的键名自动从「隐藏」中移除，重新显示（修复删除后再次上报不重现的问题）
      if (currentKeys.length > 0) {
        const keySet = new Set(currentKeys)
        hiddenSensorKeys.value = hiddenSensorKeys.value.filter((k: string) => !keySet.has(k))
      }
      realtimeDataMap.value = map
      realtimeDataList.value = Object.values(map).filter((item: any) => !hiddenSensorKeys.value.includes(item.key))
      // 根据上报数据回显开关状态（下位机发来的 0/1 驱动开关显示）
      updateSwitchStates(json)
      // 更新自动/手动模式
      updateAutoMode()
    }

    // 原始JSON：无论显示/隐藏，只要收到数据都推入
    const deviceJson: Record<string, any> = {}
    for (const [key, val] of Object.entries(json)) {
      if (!isSpecial) {
        const deviceIdFromKey = parseInt((key.match(/(\d+)$/) || [''])[0], 10)
        if (deviceIdFromKey !== parseInt(deviceId.value)) continue
      }
      deviceJson[key] = String(val)
    }
    if (Object.keys(deviceJson).length > 0) {
      // 只有未隐藏的消息才算「收到实时数据」，驱动在线判定
      if (!shouldHideRealtime) markDataReceived()
      const timeStr = new Date(now).toLocaleString()
      const content = JSON.stringify(deviceJson, Object.keys(deviceJson).sort(), 2)
      console.log('[MQTT] 推送 rawJsonList, now=', now, 'content keys=', Object.keys(deviceJson), 'shouldHideRealtime=', shouldHideRealtime)
      pushRawJson({ time: timeStr, json: content })
      rawJsonPushedTs = now
      nextTick(() => { rawJsonScrollTop.value = rawJsonScrollTop.value + 1 + 99999 })
    }
    // 即时检测阈值
    checkThresholds()
  } catch (e) {}
}

// ========== 网页浏览（WebView） ==========
const webviewUrlInput = ref('')
const webviewPageUrlSaved = ref('')
const webviewConnected = ref(false)
const webviewPageUrl = ref('')
const webviewLoading = ref(false)
const showScreenshotSidebar = ref(false)
const screenshots = ref([])
const showScreenshotPreview = ref(false)
const screenshotPreview = ref({ image: '', objects: [] })
let webviewTimer = null

const loadWebviewConfig = async () => {
  try {
    const data = await getWebviewConfig(deviceId.value)
    if (data && data.page_url) {
      webviewPageUrlSaved.value = data.page_url
      webviewUrlInput.value = data.page_url
    }
  } catch (err) {
    console.error('加载网页配置失败', err)
  }
}

const handleFillWebviewUrl = async () => {
  try {
    const data = await getWebviewConfig(deviceId.value)
    if (data && data.page_url) {
      webviewUrlInput.value = data.page_url
      webviewPageUrlSaved.value = data.page_url
      uni.showToast({ title: '已填充', icon: 'success' })
    } else {
      uni.showToast({ title: '无已保存配置', icon: 'none' })
    }
  } catch (err) {
    uni.showToast({ title: '获取配置失败', icon: 'none' })
  }
}

const handleConnectWebview = async () => {
  const url = webviewUrlInput.value.trim()
  if (!url) {
    uni.showToast({ title: '请输入网页地址', icon: 'none' })
    return
  }
  webviewLoading.value = true

  // 记住本次输入的 URL，方便下次"填充"使用
  webviewPageUrlSaved.value = url
  try { await saveWebviewConfig(deviceId.value, url) } catch (e) {}

  // 判断是否需要代理注入：YOLOv8 页面（通常端口 9000）走代理，普通网页直连
  const needsInjection = /:9000/.test(url) || /yolo/i.test(url)

  if (needsInjection) {
    const backendHost = getBackendHost()
    webviewPageUrl.value = `http://${backendHost}:${BACKEND_PORT}/api/webview-proxy/${deviceId.value}?inject=1`
  } else {
    // 直接加载原网址，不加代理
    if (!/^https?:\/\//i.test(url)) {
      webviewPageUrl.value = 'http://' + url
    } else {
      webviewPageUrl.value = url
    }
  }

  webviewConnected.value = true
  webviewLoading.value = false

  // 仅代理模式需要轮询截图
  if (needsInjection) {
    showScreenshotSidebar.value = true
    await loadScreenshots()
    if (webviewTimer) clearInterval(webviewTimer)
    webviewTimer = setInterval(loadScreenshots, 3000)
  } else {
    showScreenshotSidebar.value = false
    screenshots.value = []
    if (webviewTimer) { clearInterval(webviewTimer); webviewTimer = null }
  }
}

const loadScreenshots = async () => {
  try {
    const data = await getWebviewScreenshots(deviceId.value)
    screenshots.value = data || []
  } catch (err) {
    console.error('加载截图记录失败', err)
  }
}

const viewScreenshot = (item) => {
  screenshotPreview.value = {
    image: item.image_base64,
    objects: JSON.parse(item.json_data || '{}').objects || []
  }
  showScreenshotPreview.value = true
}

let pollingTimer = null
const startPolling = () => { pollingTimer = setInterval(() => loadHistoryData(), 2000) }

const realtimeDataList = ref([])
const rawJsonList = ref([])
const rawJsonScrollTop = ref(0)

// 原始 JSON 分页（RuoYi 风格）
const rawJsonPage = ref(1)
const rawJsonPageSize = ref(20)
const rawJsonJumpPage = ref('')
const rawJsonPageSizeOptions = [10, 20, 50, 100]
const rawJsonTotalPages = computed(() => Math.max(1, Math.ceil(rawJsonList.value.length / rawJsonPageSize.value)))
const rawJsonPageSizeIndex = computed(() => {
  const idx = rawJsonPageSizeOptions.indexOf(rawJsonPageSize.value)
  return idx >= 0 ? idx : 1
})
const rawJsonPageList = computed(() => {
  const total = rawJsonTotalPages.value
  const cur = rawJsonPage.value
  if (total <= 7) {
    const arr = []
    for (let i = 1; i <= total; i++) arr.push(i)
    return arr
  }
  const pages = new Set([1, total, cur - 1, cur, cur + 1])
  const sorted = Array.from(pages).filter(p => p >= 1 && p <= total).sort((a, b) => a - b)
  const list = []
  let prev = 0
  for (const p of sorted) {
    if (prev && p - prev > 1) list.push(-1)
    list.push(p)
    prev = p
  }
  return list
})
const rawJsonPagedList = computed(() => {
  const start = (rawJsonPage.value - 1) * rawJsonPageSize.value
  return rawJsonList.value.slice(start, start + rawJsonPageSize.value)
})
let rawJsonFollowLatest = true

// 原始 JSON 记录追加（限制条数，防止长期运行 DOM 膨胀卡顿）
const pushRawJson = (entry) => {
  rawJsonList.value.push(entry)
  if (rawJsonList.value.length > 200) {
    rawJsonList.value.splice(0, rawJsonList.value.length - 200)
  }
  if (rawJsonFollowLatest) {
    rawJsonPage.value = rawJsonTotalPages.value
  }
}

const clearRawJson = () => {
  rawJsonList.value = []
  rawJsonPage.value = 1
  rawJsonJumpPage.value = ''
  rawJsonFollowLatest = true
}
const goRawJsonPage = (p) => {
  if (p < 1 || p > rawJsonTotalPages.value || p === rawJsonPage.value) return
  rawJsonPage.value = p
  rawJsonFollowLatest = (p >= rawJsonTotalPages.value)
}
const onRawJsonPageSizeChange = (e) => {
  const idx = Number(e.detail.value)
  rawJsonPageSize.value = rawJsonPageSizeOptions[idx]
  rawJsonPage.value = 1
  rawJsonFollowLatest = false
}
const onRawJsonJumpPage = () => {
  const p = parseInt(rawJsonJumpPage.value)
  if (!p || p < 1) {
    uni.showToast({ title: '请输入有效页码', icon: 'none' })
    return
  }
  if (p > rawJsonTotalPages.value) {
    uni.showToast({ title: '超过总页数', icon: 'none' })
    return
  }
  rawJsonPage.value = p
  rawJsonJumpPage.value = ''
  rawJsonFollowLatest = (p >= rawJsonTotalPages.value)
}

// 原始JSON 长按编辑 + 回写数据库
const showRawJsonEdit = ref(false)
const rawJsonEditText = ref('')
const rawJsonEditError = ref('')
let rawJsonEditItem: any = null

const editRawJson = (item) => {
  rawJsonEditItem = item
  rawJsonEditText.value = item.json
  rawJsonEditError.value = ''
  showRawJsonEdit.value = true
}
const closeRawJsonEdit = () => {
  showRawJsonEdit.value = false
  rawJsonEditItem = null
  rawJsonEditError.value = ''
}
const saveRawJsonEdit = async () => {
  const item = rawJsonEditItem
  if (!item) return
  let parsed: any
  try {
    parsed = JSON.parse(rawJsonEditText.value)
  } catch (e) {
    rawJsonEditError.value = 'JSON 格式错误'
    return
  }
  // 校验通过后立即更新内存并关闭窗口，再异步回写数据库
  item.json = rawJsonEditText.value
  showRawJsonEdit.value = false
  rawJsonEditItem = null
  const src = item.src
  // 回写数据库：只有真正写库失败才提示「修改失败」
  try {
    if (src && src.table === 'special_data' && src.id) {
      await updateQueryRecord({ table: 'special_data', id: src.id, json_data: JSON.stringify(parsed) })
    } else if (src && src.table === 'sensor_history' && src.timestamp) {
      const res = await request({ url: '/sensor-history-group', method: 'PUT', data: { deviceId: parseInt(deviceId.value), timestamp: src.timestamp, values: parsed } })
      if (res.data.code !== 200) throw new Error(res.data.message || '更新失败')
    } else {
      uni.showToast({ title: '已修改（该条未入库，仅本次生效）', icon: 'none' })
      return
    }
  } catch (e) {
    uni.showToast({ title: '修改失败', icon: 'none' })
    return
  }
  // 写库成功后再提示并刷新图表；刷新失败不影响成功提示
  uni.showToast({ title: '修改成功', icon: 'success' })
  try {
    await refreshHistoryChart()
  } catch (e) { console.error('刷新历史数据失败', e) }
}

