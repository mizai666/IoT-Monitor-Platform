const openThemeAction = (theme: any) => {
  uni.showActionSheet({
    itemList: ['修改', '删除'],
    success: (res: any) => {
      if (res.tapIndex === 0) {
        editingTheme.value = theme
        themeForm.value = {
          themeCode: theme.theme_code,
          displayName: theme.display_name,
          httpKeyName: theme.http_key_name || '',
          httpKeyValue: theme.http_key_value || '',
          mqttKeyName: theme.mqtt_key_name || '',
          mqttKeyValue: theme.mqtt_key_value || '',
          publishTopic: theme.publish_topic
        }
        themeCodeIndex.value = themeCodeValues.indexOf(theme.theme_code)
        if (themeCodeIndex.value < 0) themeCodeIndex.value = 0
        showThemeForm.value = true
      } else if (res.tapIndex === 1) {
        confirmDeleteTheme(theme)
      }
    }
  })
}

const confirmDeleteTheme = (theme: any) => {
  uni.showModal({
    title: '确认删除',
    content: `删除主题「${theme.display_name}」？`,
    success: async (res: any) => {
      if (res.confirm) {
        try {
          await deleteThemeConfig(theme.id)
          uni.showToast({ title: '已删除', icon: 'success' })
          await loadThemes()
        } catch (err) {
          uni.showToast({ title: '删除失败', icon: 'none' })
        }
      }
    }
  })
}

const activateThemeAction = async (theme: any) => {
  if (deviceOffline.value) {
    uni.showToast({ title: '设备离线，无法操作', icon: 'none' })
    return
  }
  try {
    await activateTheme(theme.id)
    if (theme.mqtt_key_name && theme.mqtt_key_value && theme.publish_topic) {
      await sendMqttRaw(theme.publish_topic, JSON.stringify({ [theme.mqtt_key_name]: theme.mqtt_key_value }), publishQos.value)
    }
    await loadThemes()
    uni.showToast({ title: '主题已切换: ' + getThemeLabel(theme.theme_code), icon: 'success' })
  } catch (err) {
    uni.showToast({ title: '切换失败', icon: 'none' })
  }
}

// 主题匹配（MQTT 上行数据触发）
const matchThemeFromMqtt = async (json: Record<string, any>, keys: string[]) => {
  try {
    await loadThemes()
    const normalizedJson: Record<string, any> = {}
    for (const [k, v] of Object.entries(json)) {
      const did = parseInt((k.match(/(\d+)$/) || [''])[0], 10)
      if (did && did !== parseInt(deviceId.value)) continue
      normalizedJson[stripTrailingNum(k)] = v
      normalizedJson[k] = v
    }
    let mqttMatchedTheme: any = null
    for (const theme of themes.value) {
      if (!theme.http_key_name || !theme.http_key_value) continue
      const actualVal = normalizedJson[theme.http_key_name]
      if (actualVal !== undefined && String(actualVal) === theme.http_key_value) {
        mqttMatchedTheme = theme
        break
      }
    }
    if (mqttMatchedTheme) {
      if (mqttMatchedTheme.is_active === 1) {
        console.log('[主题MQTT] 已是激活主题，跳过重复下发')
        return
      }
      await activateTheme(mqttMatchedTheme.id)
      if (mqttMatchedTheme.mqtt_key_name && mqttMatchedTheme.mqtt_key_value && mqttMatchedTheme.publish_topic) {
        await sendMqttRaw(mqttMatchedTheme.publish_topic, JSON.stringify({ [mqttMatchedTheme.mqtt_key_name]: mqttMatchedTheme.mqtt_key_value }), publishQos.value)
      }
      await loadThemes()
    }
  } catch (e) { console.error('[主题MQTT] 异常:', e) }
}

