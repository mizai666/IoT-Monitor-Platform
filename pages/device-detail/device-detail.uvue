// 通用 JSON 路径取值（支持点分隔、方括号索引、* 通配、** 递归）
const parsePath = (path: string): any[] => {
  const segs: any[] = []
  const s = String(path || '').trim()
  const re = /([^.\[\]]+)|\[([^\]]*)\]/g
  let m: any
  while ((m = re.exec(s)) !== null) {
    if (m[1] !== undefined) {
      segs.push({ kind: 'key', key: m[1] })
    } else {
      let inner = (m[2] || '').trim()
      if ((inner.startsWith("'") && inner.endsWith("'")) || (inner.startsWith('"') && inner.endsWith('"'))) {
        inner = inner.slice(1, -1)
      }
      segs.push({ kind: 'key', key: inner })
    }
  }
  return segs
}

const _resolve = (node: any, segs: any[], idx: number, results: any[]) => {
  if (idx >= segs.length) {
    results.push(node)
    return
  }
  const key = segs[idx].key
  if (key === '**') {
    _resolve(node, segs, idx + 1, results)
    if (Array.isArray(node)) {
      for (const it of node) _resolve(it, segs, idx, results)
    } else if (node && typeof node === 'object') {
      for (const v of Object.values(node)) _resolve(v, segs, idx, results)
    }
    return
  }
  if (key === '*') {
    if (Array.isArray(node)) {
      for (const it of node) _resolve(it, segs, idx + 1, results)
    }
    return
  }
  let child: any
  if (Array.isArray(node)) {
    const n = Number(key)
    if (Number.isInteger(n) && String(n) === key) child = node[n]
  } else if (node && typeof node === 'object') {
    child = node[key]
  }
  if (child !== undefined) _resolve(child, segs, idx + 1, results)
}

const getByPath = (obj: any, path: string): any => {
  const segs = parsePath(path)
  if (segs.length === 0) return obj
  const results: any[] = []
  _resolve(obj, segs, 0, results)
  const hasWild = String(path || '').includes('*')
  if (hasWild) return results
  return results.length ? results[0] : undefined
}

// ========== 命令值 → 开(1)/关(0) 映射 ==========
const BUILTIN_ON = new Set(['on', '1', 'true', 'open', 'enable', 'enabled', 'start', 'high', 'up', 'run', 'active', 'turn_on', '开'])
const BUILTIN_OFF = new Set(['off', '0', 'false', 'close', 'disable', 'disabled', 'stop', 'low', 'down', 'idle', 'inactive', 'turn_off', '关'])

const parseValueMap = (text: string): Record<string, boolean> => {
  const map: Record<string, boolean> = {}
  if (!text) return map
  const onSet = new Set(['on', '1', 'true', '开', 'open', 'enable', 'enabled'])
  const offSet = new Set(['off', '0', 'false', '关', 'close', 'disable', 'disabled'])
  const entries = String(text).split(/[,;\n，；]+/)
  for (const e of entries) {
    const kv = e.split(/[=:：]/)
    if (kv.length < 2) continue
    const k = kv[0].trim().toLowerCase()
    const v = kv[1].trim().toLowerCase()
    if (!k) continue
    if (onSet.has(v)) map[k] = true
    else if (offSet.has(v)) map[k] = false
  }
  return map
}

const matchValue = (cmd: any, customMap: string): number | null => {
  const norm = String(cmd ?? '').trim().toLowerCase()
  if (!norm) return null
  const custom = parseValueMap(customMap)
  if (custom[norm] !== undefined) return custom[norm] ? 1 : 0
  if (BUILTIN_ON.has(norm)) return 1
  if (BUILTIN_OFF.has(norm)) return 0
  return null
}
const checkedRecords = ref([])
let mqttPublishClient = null
let realtimeMqttClient = null

const connectRealtimeMqtt = () => {
  if (!port.value || !topic.value) {
    console.log('[详情页MQTT] 无端口或主题，跳过连接')
    return
  }
  const host = brokerHost.value || '127.0.0.1'
  const clientId = 'detail_' + deviceId.value + '_' + Date.now()
  console.log('[详情页MQTT] 正在连接', host, port.value, topic.value)
  realtimeMqttClient = new mqtt.Client(host, Number(port.value) || 8083, clientId)
  realtimeMqttClient.onMessageArrived = (msg: any) => {
    console.log('[MQTT详情页] 收到消息 topic=', msg.destinationName, 'payload长度=', msg.payloadString.length)
    handleRealtimeMqttMessage(msg.payloadString)
  }
  realtimeMqttClient.onConnectionLost = (err: any) => {
    console.log('[详情页MQTT] 连接断开', err)
  }
  realtimeMqttClient.connect({
    onSuccess: () => {
      console.log('[详情页MQTT] 连接成功，订阅', topic.value)
      realtimeMqttClient.subscribe(topic.value, { qos: 0 })
    },
    onFailure: (err: any) => {
      console.error('[详情页MQTT] 连接失败', err)
    }
  })
}

