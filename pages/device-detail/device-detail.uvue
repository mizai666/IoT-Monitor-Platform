const loadSchedules = async () => {
  try {
    const data = await getScheduleConfigs(deviceId.value)
    schedules.value = data
    // 为尚未开始计时的定时任务初始化倒计时起点，让倒计时立即显示秒数
    const now = Date.now()
    for (const sch of data) {
      if (sch.enabled === 1 && !scheduleStartTimes.value.has(sch.id)) {
        scheduleStartTimes.value.set(sch.id, now)
      }
    }
  } catch (err) {
    console.error('加载定时列表失败', err)
  }
}

