const confirmDeleteSwitch = (sw) => {
  uni.showModal({
    title: '确认删除',
    content: `确定删除开关"${sw.display_name}"吗？`,
    confirmColor: '#ff3b30',
    success: async (res) => {
      if (res.confirm) {
        try {
          await deleteSwitchConfig(sw.id)
          uni.showToast({ title: '删除成功', icon: 'success' })
          await loadSwitches()
        } catch (err) {
          uni.showToast({ title: '删除失败', icon: 'error' })
        }
      }
    }
  })
}

const ensureSwitchMqttClient = () => {
  return new Promise((resolve, reject) => {
    if (switchMqttClient && switchMqttClient.isConnected()) {
      resolve()
      return
    }
    switchMqttClient = new mqtt.Client(brokerHost.value, Number(port.value) || 8083, 'switch_' + deviceId.value + '_' + Date.now())
    switchMqttClient.connect({
      onSuccess: () => resolve(),
      onFailure: (err) => reject(err)
    })
  })
}

// 根据 MQTT 数据更新开关状态
const updateSwitchStates = (latestValues) => {
  if (!latestValues || switches.value.length === 0) return
  for (const sw of switches.value) {
    // 先精确匹配 key_name，再尝试去掉末尾数字后匹配
    let rawValue = latestValues[sw.key_name]
    if (rawValue === undefined) {
      const cleaned = sw.key_name.replace(/\d+$/, '')
      if (cleaned !== sw.key_name) {
        rawValue = latestValues[cleaned]
      }
    }
    if (rawValue !== undefined) {
      const numVal = Number(rawValue)
      const activeHigh = sw.active_high === 1
      const newIsOn = activeHigh ? (numVal >= 1) : (numVal === 0)
      // 状态变化时才更新并持久化，避免无意义写库
      if (sw.isOn !== newIsOn) {
        sw.isOn = newIsOn
        updateSwitchState(sw.id, newIsOn).catch(e => console.error('保存开关状态失败', e))
      }
    }
  }
}

// 记录发送历史（开关/主题等 MQTT 下发都记入发送记录）
const recordSendHistory = (topic, payload) => {
  request({
    url: '/publish-history',
    method: 'POST',
    data: {
      deviceId: deviceId.value,
      type: 'mqtt',
      topic,
      payload,
      qos: '0'
    }
  }).catch(() => {})
}

const handleSwitchToggle = async (sw, event) => {
  if (deviceOffline.value) {
    uni.showToast({ title: '设备离线，无法操作', icon: 'none' })
    return
  }
  if (currentMode.value === 'auto') {
    uni.showToast({ title: '自动模式下不可操作', icon: 'none' })
    return
  }
  const newValue = event.detail.value
  const activeHigh = sw.active_high === 1
  const sendValue = newValue ? (activeHigh ? 1 : 0) : (activeHigh ? 0 : 1)
  const payload = JSON.stringify({ [sw.key_name]: sendValue })

  sw.isOn = newValue

  try {
    await ensureSwitchMqttClient()
    const msg = new mqtt.Message(payload)
    msg.destinationName = sw.publish_topic
    msg.qos = 0
    switchMqttClient.send(msg)
    // 下发的开关指令同步更新实时数据区（开关值随下发立即变化）
    handleRealtimeMqttMessage(payload)
    recordSendHistory(sw.publish_topic, payload)
    // 持久化开关操作到传感器历史，数据一览/历史查询可回显
    saveSensorData(parseInt(deviceId.value), sw.key_name, sendValue, Date.now()).catch(e => console.error('记录开关状态失败', e))
    updateSwitchState(sw.id, newValue).catch(e => console.error('保存开关状态失败', e))
    uni.showToast({ title: `已发送: ${payload}`, icon: 'success', duration: 1200 })
  } catch (err) {
    sw.isOn = !newValue
    console.error('开关发送失败', err)
    uni.showToast({ title: '发送失败', icon: 'error' })
  }
}

const publishToAllSwitches = async (on) => {
  if (deviceOffline.value) {
    uni.showToast({ title: '设备离线，无法操作', icon: 'none' })
    return
  }
  if (currentMode.value === 'auto') {
    uni.showToast({ title: '自动模式下不可操作', icon: 'none' })
    return
  }
  try {
    await ensureSwitchMqttClient()
    for (const sw of switches.value) {
      const activeHigh = sw.active_high === 1
      const sendValue = on ? (activeHigh ? 1 : 0) : (activeHigh ? 0 : 1)
      const payload = JSON.stringify({ [sw.key_name]: sendValue })
      const msg = new mqtt.Message(payload)
      msg.destinationName = sw.publish_topic
      msg.qos = 0
      switchMqttClient.send(msg)
      // 下发的开关指令同步更新实时数据区（开关值随下发立即变化）
      handleRealtimeMqttMessage(payload)
      recordSendHistory(sw.publish_topic, payload)
      // 持久化开关操作到传感器历史，数据一览/历史查询可回显
      saveSensorData(parseInt(deviceId.value), sw.key_name, sendValue, Date.now()).catch(e => console.error('记录开关状态失败', e))
      sw.isOn = on
      updateSwitchState(sw.id, on).catch(e => console.error('保存开关状态失败', e))
    }
    uni.showToast({ title: on ? '全部已开启' : '全部已关闭', icon: 'success', duration: 1200 })
  } catch (err) {
    console.error('批量操作失败', err)
    uni.showToast({ title: '操作失败', icon: 'error' })
  }
}

const allSwitchesOn = () => publishToAllSwitches(true)
const allSwitchesOff = () => publishToAllSwitches(false)

const loadPublishConfig = async () => {
  try {
    const res = await request({ url: `/publish-configs?deviceId=${deviceId.value}`, method: 'GET' })
    if (res.data.code === 200 && res.data.data) {
      publishTopic.value = res.data.data.topic || ''
      publishQos.value = res.data.data.qos || 0
    }
  } catch(e) { console.error(e) }
}

const savePublishConfig = async () => {
  if (!publishTopic.value.trim()) {
    uni.showToast({ title: '请输入主题', icon: 'none' })
    return
  }
  try {
    const res = await request({
      url: '/publish-configs',
      method: 'POST',
      data: {
        topic: publishTopic.value.trim(),
        qos: publishQos.value,
        broker_url: '127.0.0.1',
        port: port.value || 8083,
        client_id: 'publisher_' + deviceId.value
      }
    })
    if (res.data.code === 200) {
      uni.showToast({ title: '保存成功', icon: 'success' })
    }
  } catch(e) { console.error(e) }
}

const sendMqttRaw = async (topic: string, payload: string, qos: number) => {
  try {
    if (!mqttPublishClient || !mqttPublishClient.isConnected()) {
      mqttPublishClient = new mqtt.Client(brokerHost.value, Number(port.value) || 8083, 'publisher_' + deviceId.value + '_' + Date.now())
      await new Promise((resolve, reject) => {
        mqttPublishClient.connect({ onSuccess: resolve, onFailure: (err: any) => reject(err) })
      })
    }
    const msg = new mqtt.Message(payload)
    msg.destinationName = topic
    msg.qos = qos
    mqttPublishClient.send(msg)
    console.log('[sendMqttRaw] 已发送 topic=', topic, 'payload=', payload)
  } catch (e) { console.error('[sendMqttRaw] 失败:', e) }
}

// 判断数据是否匹配定时任务的响应规则（目标字段匹配到 key_name 即触发）
const matchScheduleTarget = (respData: any, sch: any): boolean => {
  const targetLower = String(sch.key_name).trim().toLowerCase()
  const respTargetKey = sch.resp_target_key
  const respArrayPath = sch.resp_array_path
  // 平铺模式：顶层扫描 target / target_N
  if (respTargetKey) {
    if (respTargetKey in respData && String(respData[respTargetKey]).trim().toLowerCase() === targetLower) return true
    const esc = respTargetKey.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
    for (const key of Object.keys(respData)) {
      const m = key.match(new RegExp('^' + esc + '_(\\d+)$'))
      if (m && String(respData[key]).trim().toLowerCase() === targetLower) return true
    }
  }
  // 数组路径模式
  if (respArrayPath) {
    const arrVal = getByPath(respData, respArrayPath)
    const items = Array.isArray(arrVal) ? arrVal : (arrVal == null ? [] : [arrVal])
    for (const item of items) {
      const tv = (item && typeof item === 'object' && respTargetKey) ? getByPath(item, respTargetKey) : item
      if (String(tv).trim().toLowerCase() === targetLower) return true
    }
  }
  // 兜底：数据里直接出现该键名
  if (respData[sch.key_name] !== undefined) return true
  return false
}

// 定时任务响应规则：MQTT/HTTP 数据匹配到则重置倒计时
const runScheduleResponse = async (respData: any) => {
  if (!respData || typeof respData !== 'object') return
  try {
    await loadSchedules()
    let resetCount = 0
    for (const sch of schedules.value) {
      if (sch.enabled !== 1) continue
      if (!sch.resp_target_key && !sch.resp_array_path) continue
      if (matchScheduleTarget(respData, sch)) {
        scheduleStartTimes.value.set(sch.id, Date.now())
        sch._lastExecuted = null
        resetCount++
        console.log('[定时响应] 重置倒计时:', sch.display_name)
      }
    }
    if (resetCount > 0) {
      uni.showToast({ title: `已重置 ${resetCount} 个定时任务`, icon: 'success' })
    }
  } catch (e) { console.error('[定时响应] 异常:', e) }
}

// 阈值响应规则：HTTP 响应取新上下限，改阈值 + 发下位机 + 报警
const runThresholdResponse = async (respData: any) => {
  if (!respData || typeof respData !== 'object') return
  try {
    await loadThresholds()
    let changed = 0
    for (const th of thresholds.value) {
      if (!th.resp_max_path && !th.resp_min_path) continue
      const rawMax = th.resp_max_path ? getByPath(respData, th.resp_max_path) : null
      const rawMin = th.resp_min_path ? getByPath(respData, th.resp_min_path) : null
      const newMax = rawMax != null && rawMax !== '' ? parseFloat(rawMax) : NaN
      const newMin = rawMin != null && rawMin !== '' ? parseFloat(rawMin) : NaN
      if (isNaN(newMax) && isNaN(newMin)) continue
      const finalMax = isNaN(newMax) ? th.max_value : newMax
      const finalMin = isNaN(newMin) ? th.min_value : newMin
      await updateThresholdConfig(th.id, {
        sensorKey: th.sensor_key,
        displayName: th.display_name,
        minValue: finalMin,
        maxValue: finalMax,
        alarmMessage: th.alarm_message || '',
        sendToDevice: th.send_to_device === 1,
        upperKey: th.upper_key || '',
        lowerKey: th.lower_key || '',
        publishTopic: th.publish_topic || '',
        enabled: th.enabled,
        respMaxPath: th.resp_max_path || '',
        respMinPath: th.resp_min_path || ''
      })
      // 同步发送给下位机（用预设的上下限键名）
      if (th.send_to_device === 1 && th.publish_topic && th.upper_key && th.lower_key) {
        try {
          await ensureSwitchMqttClient()
          const payloadJson = JSON.stringify({ [th.upper_key]: finalMax, [th.lower_key]: finalMin })
          const msg = new mqtt.Message(payloadJson)
          msg.destinationName = th.publish_topic
          msg.qos = 0
          switchMqttClient.send(msg)
        } catch (e) { console.error('[阈值响应] 发送下位机失败:', e) }
      }
      changed++
      console.log('[阈值响应] 已更新阈值:', th.display_name, finalMin, '~', finalMax)
    }
    if (changed > 0) {
      await loadThresholds()
      checkThresholds()
    }
  } catch (e) { console.error('[阈值响应] 异常:', e) }
}

const validatePayloadFormat = (raw: string): string => {
  const fmt = payloadFormat.value
  if (fmt === 0) {
    const t = raw.trim()
    if (!(t.startsWith('{') || t.startsWith('['))) {
      return 'JSON 格式错误：消息体应为对象或数组'
    }
    try {
      JSON.parse(t)
      return ''
    } catch (e) {
      return 'JSON 格式错误：无法解析'
    }
  }
  if (fmt === 1) return ''
  if (fmt === 2) {
    const low = raw.toLowerCase()
    if (low === 'true' || low === 'false') return ''
    return '布尔值格式错误：应为 true 或 false'
  }
  if (fmt === 3) {
    if (!isNaN(Number(raw))) return ''
    return '数字格式错误：应为有效数字'
  }
  return ''
}

const sendPublish = async () => {
  if (!publishTopic.value.trim()) {
    uni.showToast({ title: '请输入主题', icon: 'none' })
    return
  }
  const payloadRaw = publishPayload.value.trim()
  if (!payloadRaw) {
    uni.showToast({ title: '请输入消息体', icon: 'none' })
    return
  }
  const fmtErr = validatePayloadFormat(payloadRaw)
  if (fmtErr) {
    uni.showToast({ title: fmtErr, icon: 'none' })
    return
  }
  try {
    if (!mqttPublishClient || !mqttPublishClient.isConnected()) {
      mqttPublishClient = new mqtt.Client(brokerHost.value, Number(port.value) || 8083, 'publisher_' + deviceId.value + '_' + Date.now())
      await new Promise((resolve, reject) => {
        mqttPublishClient.connect({
          onSuccess: resolve,
          onFailure: (err: any) => reject(err)
        })
      })
    }
    const msg = new mqtt.Message(publishPayload.value.trim())
    msg.destinationName = publishTopic.value.trim()
    msg.qos = publishQos.value
    mqttPublishClient.send(msg)
    // 发出的数据同步更新实时数据区（实时数据/开关/原始JSON 等，走与订阅消息相同处理链）
    handleRealtimeMqttMessage(publishPayload.value.trim())

    await request({
      url: '/publish-history',
      method: 'POST',
      data: {
        deviceId: deviceId.value,
        topic: publishTopic.value.trim(),
        payload: publishPayload.value.trim(),
        qos: publishQos.value
      }
    })
    publishPayload.value = ''
    uni.showToast({ title: '发送成功', icon: 'success' })
    loadPublishHistory()
  } catch(e) {
    console.error(e)
    uni.showToast({ title: '发送失败: ' + (e.message || e), icon: 'none' })
  }
}

const pad2 = (n: number) => (n < 10 ? '0' + n : String(n))
const formatTimestamp = (d: Date) => {
  const fmt = tsFormats[tsFormatIndex.value]
  return fmt
    .replace('YYYY', String(d.getFullYear()))
    .replace('MM', pad2(d.getMonth() + 1))
    .replace('DD', pad2(d.getDate()))
    .replace('HH', pad2(d.getHours()))
    .replace('mm', pad2(d.getMinutes()))
    .replace('ss', pad2(d.getSeconds()))
}

const sendTimestamp = async () => {
  if (!tsTopic.value.trim()) {
    uni.showToast({ title: '请输入时间戳主题', icon: 'none' })
    return
  }
  const payload = formatTimestamp(new Date())
  try {
    if (!mqttPublishClient || !mqttPublishClient.isConnected()) {
      mqttPublishClient = new mqtt.Client(brokerHost.value, Number(port.value) || 8083, 'publisher_' + deviceId.value + '_' + Date.now())
      await new Promise((resolve, reject) => {
        mqttPublishClient.connect({
          onSuccess: resolve,
          onFailure: (err: any) => reject(err)
        })
      })
    }
    const msg = new mqtt.Message(payload)
    msg.destinationName = tsTopic.value.trim()
    msg.qos = publishQos.value
    mqttPublishClient.send(msg)
    await request({
      url: '/publish-history',
      method: 'POST',
      data: {
        deviceId: deviceId.value,
        topic: tsTopic.value.trim(),
        payload,
        qos: publishQos.value
      }
    })
    uni.showToast({ title: '时间戳已发送', icon: 'success' })
    loadPublishHistory()
  } catch (e) {
    console.error(e)
    uni.showToast({ title: '发送失败: ' + (e.message || e), icon: 'none' })
  }
}

const loadPublishHistory = async () => {
  try {
    const res = await request({ url: `/publish-history?deviceId=${deviceId.value}`, method: 'GET' })
    if (res.data.code === 200) {
      publishHistory.value = res.data.data.map(r => ({
        time: new Date(r.created_at).toLocaleString(),
        type: r.type || 'mqtt',
        method: r.method || '',
        ok: r.type === 'http' ? !!r.ok : true,
        status: r.status || '',
        url: r.url || '',
        topic: r.topic,
        payload: r.payload,
        responseData: r.response_data || '',
        qos: r.qos
      }))
      publishScrollTop.value = publishScrollTop.value + 1 + 99999
    }
  } catch(e) { console.error(e) }
}

// 加载HTTP响应记录到原始JSON区域（仅 onMounted 调用一次）
const loadHttpRawJson = async () => {
  try {
    const res = await request({ url: `/publish-history?deviceId=${deviceId.value}`, method: 'GET' })
    if (res.data.code === 200) {
      const httpRecords = res.data.data.filter(r => r.type === 'http' && r.response_data)
      for (let i = httpRecords.length - 1; i >= 0; i--) {
        const r = httpRecords[i]
        const isJson = r.response_data.trim().startsWith('{') || r.response_data.trim().startsWith('[')
        if (isJson) {
          try {
            const parsed = JSON.parse(r.response_data)
            rawJsonList.value.push({
              time: new Date(r.created_at).toLocaleString(),
              json: JSON.stringify({ type: 'http_response', status: r.status, response: parsed }, null, 2)
            })
          } catch (e) { /* skip malformed json */ }
        } else {
          rawJsonList.value.push({
            time: new Date(r.created_at).toLocaleString(),
            json: JSON.stringify({ type: 'http_response', status: r.status, response: r.response_data }, null, 2)
          })
        }
      }
    }
  } catch(e) { console.error(e) }
}

const onQosChange = (e) => { publishQos.value = e.detail.value }

const loadSensorRecords = async () => {
  try {
    const isSpecial = deviceType.value === 'special'
    if (isSpecial) {
      // 特殊设备从 special_data 表读取
      const res = await request({ url: `/special-data?deviceId=${deviceId.value}&limit=20`, method: 'GET' })
      if (res.data?.code === 200 && res.data.data) {
        recordList.value = res.data.data.map((r: any) => ({
          time: new Date(r.timestamp).toLocaleString(),
          json: (() => { try { return JSON.parse(r.json_data) } catch (e) { return r.json_data } })()
        }))
      }
    } else {
      // 普通设备：按时间戳聚合 sensor_history 行，组成完整JSON
      const res = await request({ url: `/sensor-history?deviceId=${deviceId.value}&limit=200`, method: 'GET' })
      if (res.data?.code === 200 && res.data.data) {
        const groups: Record<number, Record<string, any>> = {}
        const rows = res.data.data
        rows.forEach((r: any) => {
          const ts = r.timestamp
          if (!groups[ts]) groups[ts] = {}
          groups[ts][r.sensor_name] = r.value
        })
        recordList.value = Object.entries(groups)
          .sort((a, b) => Number(b[0]) - Number(a[0]))
          .slice(0, 20)
          .map(([ts, values]) => ({ time: new Date(Number(ts)).toLocaleString(), json: values }))
      }
    }
  } catch (e) { console.error('加载传感器记录失败', e) }
}

const toggleRecord = (idx) => {
  const pos = checkedRecords.value.indexOf(idx)
  if (pos >= 0) { checkedRecords.value.splice(pos, 1) }
  else { checkedRecords.value.push(idx) }
}

const confirmRecords = () => {
  if (checkedRecords.value.length === 0) { return }
  const items = checkedRecords.value.map(i => {
    const rec = recordList.value[i]
    return { ...rec.json, timestamp: rec.time }
  })
  publishPayload.value = JSON.stringify(items.length === 1 ? items[0] : items, null, 2)
  selectedRecordLabel.value = `已选 ${checkedRecords.value.length} 条`
  showRecordDialog.value = false
  checkedRecords.value = []
}

const sendHttp = async () => {
  if (!httpUrl.value.trim()) {
    uni.showToast({ title: '请输入HTTP地址', icon: 'none' })
    return
  }
  const isGet = httpMethod.value === 'GET'
  const payloadRaw = publishPayload.value.trim()
  if (!isGet && !payloadRaw) {
    uni.showToast({ title: 'POST 需要填写消息体', icon: 'none' })
    return
  }
  // 格式校验：与 MQTT 发送一致，JSON 格式非法时直接拦截
  if (payloadRaw) {
    const fmtErr = validatePayloadFormat(payloadRaw)
    if (fmtErr) {
      uni.showToast({ title: fmtErr, icon: 'none' })
      return
    }
  }
  try {
    let body = null
    if (payloadRaw) {
      const fmt = payloadFormat.value
      if (fmt === 0) body = JSON.parse(payloadRaw)
      else if (fmt === 1) body = payloadRaw
      else if (fmt === 2) body = payloadRaw.toLowerCase() === 'true'
      else body = Number(payloadRaw)
    }
    const res = await request({
      url: '/proxy-decision',
      method: 'POST',
      data: { url: httpUrl.value.trim(), body, method: httpMethod.value }
    })
    const result = (res.data && res.data.data) || {}
    const ok = result.status >= 200 && result.status < 300
    const respStr = typeof result.data === 'object' ? JSON.stringify(result.data) : String(result.data || '')
    publishHistory.value.unshift({
      time: new Date().toLocaleString(),
      type: 'http',
      method: httpMethod.value,
      ok,
      status: result.status || 'ERR',
      url: httpUrl.value.trim(),
      topic: httpUrl.value.trim(),
      payload: publishPayload.value.trim(),
      responseData: respStr,
      qos: '-'
    })
    // 自动匹配开关内置响应规则
    const respData = result && result.data ? result.data : result
    console.log('[规则匹配] respData=', JSON.stringify(respData).substring(0, 200))
    if (respData && typeof respData === 'object') {
      try {
        await loadSwitches()
        const swList = await getSwitchConfigs(deviceId.value)
        console.log('[规则匹配] swList.length=', swList.length, 'swList=', JSON.stringify(swList.map((s: any) => ({ kn: s.key_name, resp: s.resp_array_path + '|' + s.resp_target_key + '|' + s.resp_command_key, topic: s.publish_topic }))))
        const triggered: any[] = []
        for (const sw of swList) {
          // 标量模式：数组路径直接指向命令值（目标/命令字段都留空）
          if (!sw.resp_target_key && !sw.resp_command_key && sw.resp_array_path) {
            const cmdVal = getByPath(respData, sw.resp_array_path)
            const val = matchValue(cmdVal, sw.resp_value_map)
            console.log('[规则匹配] 标量模式', sw.key_name, '路径', sw.resp_array_path, '→', JSON.stringify(cmdVal), '→', val)
            if (val !== null) {
              triggered.push({ keyName: sw.key_name, value: val })
            } else {
              console.log('[规则匹配] ⚠ 命令值无法映射，跳过:', JSON.stringify(cmdVal))
            }
            continue
          }
          if (!sw.resp_target_key || !sw.resp_command_key) {
            console.log('[规则匹配] 跳过开关', sw.key_name, '(缺少目标/命令字段)')
            continue
          }
          // 平铺格式：数组路径留空，在响应顶层扫描 target_N/command_N
          if (!sw.resp_array_path) {
            const tKey = sw.resp_target_key
            const cKey = sw.resp_command_key
            const keyNameLower = String(sw.key_name).trim().toLowerCase()
            const matches: any[] = []
            if (tKey in respData && cKey in respData) {
              matches.push({ target: String(respData[tKey] ?? ''), cmd: respData[cKey] })
            } else {
              const escTKey = tKey.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
              for (const key of Object.keys(respData)) {
                const m = key.match(new RegExp('^' + escTKey + '_(\\d+)$'))
                if (!m) continue
                const cmdKey = cKey + '_' + m[1]
                if (!(cmdKey in respData)) continue
                matches.push({ target: String(respData[key] ?? ''), cmd: respData[cmdKey] })
              }
            }
            for (const mt of matches) {
              if (mt.target.trim().toLowerCase() !== keyNameLower) continue
              const val = matchValue(mt.cmd, sw.resp_value_map)
              console.log('[规则匹配] 平铺模式', sw.key_name, '→', JSON.stringify(mt.cmd), '→', val)
              if (val !== null) triggered.push({ keyName: sw.key_name, value: val })
            }
            continue
          }
          const arrVal = getByPath(respData, sw.resp_array_path)
          const items = Array.isArray(arrVal) ? arrVal : (arrVal === undefined || arrVal === null ? [] : [arrVal])
          console.log('[规则匹配] 开关', sw.key_name, '路径', sw.resp_array_path || '(顶层)', '→', items.length, '项')
          for (const item of items) {
            const targetVal = (item && typeof item === 'object') ? getByPath(item, sw.resp_target_key) : item
            const targetStr = String(targetVal ?? '').trim()
            if (targetStr.toLowerCase() !== String(sw.key_name).trim().toLowerCase()) continue
            const cmdVal = (item && typeof item === 'object') ? getByPath(item, sw.resp_command_key) : item
            const val = matchValue(cmdVal, sw.resp_value_map)
            console.log('[规则匹配] 目标', sw.key_name, '匹配, cmd=', JSON.stringify(cmdVal), '→', val)
            if (val === null) {
              console.log('[规则匹配] ⚠ 命令值无法映射，跳过:', JSON.stringify(cmdVal))
              continue
            }
            triggered.push({ keyName: sw.key_name, value: val })
            break
          }
        }
        console.log('[规则匹配] triggered count=', triggered.length)
        if (triggered.length > 0) {
          const topicMap: Record<string, Record<string, any>> = {}
          for (const t of triggered) {
            const sw = swList.find((s: any) => s.key_name === t.keyName)
            const topic = sw?.publish_topic?.trim()
            console.log('[规则匹配] 发送', t.keyName, '=', t.value, 'topic=', topic)
            if (!topic) { console.log('[规则匹配] ⚠ 跳过', t.keyName, '(无topic)'); continue }
            if (!topicMap[topic]) topicMap[topic] = {}
            topicMap[topic][t.keyName] = t.value
          }
          for (const [topic, payload] of Object.entries(topicMap)) {
            console.log('[规则匹配] MQTT发送 topic=', topic, 'payload=', JSON.stringify(payload))
            await sendMqttRaw(topic, JSON.stringify(payload), publishQos.value)
          }
          // 同步更新本地开关状态（松散匹配）
          for (const t of triggered) {
            const sw = switches.value.find((s: any) => {
              const rawKey = s.key_name
              const strippedKey = stripTrailingNum(rawKey)
              const targetName = stripTrailingNum(t.keyName)
              return s.key_name === t.keyName || strippedKey === targetName
                || rawKey.toLowerCase().includes(targetName.toLowerCase())
                || targetName.toLowerCase().includes(rawKey.toLowerCase())
                || strippedKey.toLowerCase().startsWith(targetName.toLowerCase())
                || targetName.toLowerCase().startsWith(strippedKey.toLowerCase())
            })
            if (sw) {
              sw.isOn = t.value === 1
              updateSwitchState(sw.id, sw.isOn).catch(e => console.error('保存开关状态失败', e))
              saveSensorData(parseInt(deviceId.value), sw.key_name, t.value === 1 ? 1 : 0, Date.now()).catch(e => console.error('记录开关状态失败', e))
            }
          }
          uni.showToast({ title: `已触发 ${triggered.length} 个开关`, icon: 'success' })
        } else {
          console.log('[规则匹配] 未触发任何开关')
        }
      } catch (e) { console.error('[规则匹配] 失败:', e) }
    } else {
      console.log('[规则匹配] respData 为空或非对象')
    }
    // 主题匹配（HTTP 响应触发）
    try {
      await loadThemes()
      const themeList = await getThemeConfigs(deviceId.value)
      let matchedTheme: any = null
      for (const theme of themeList) {
        const keyPath = theme.http_key_name
        const expectedVal = theme.http_key_value
        if (!keyPath || !expectedVal) continue
        const actualVal = getByPath(respData, keyPath)
        if (actualVal !== undefined && String(actualVal) === expectedVal) {
          matchedTheme = theme
          break
        }
      }
      if (matchedTheme) {
        if (matchedTheme.is_active === 1) {
          console.log('[主题匹配] 已是激活主题，跳过重复下发')
        } else {
          await activateTheme(matchedTheme.id)
          if (matchedTheme.mqtt_key_name && matchedTheme.mqtt_key_value && matchedTheme.publish_topic) {
            await sendMqttRaw(matchedTheme.publish_topic, JSON.stringify({ [matchedTheme.mqtt_key_name]: matchedTheme.mqtt_key_value }), publishQos.value)
          }
          await loadThemes()
        }
      }
    } catch (e) { console.error('[主题匹配] 异常:', e) }
    // 定时任务响应规则 + 阈值响应（HTTP 响应触发）
    await runScheduleResponse(respData)
    await runThresholdResponse(respData)
    publishScrollTop.value = publishScrollTop.value + 1 + 99999
    // 追加HTTP响应到原始JSON区域
    const rawJsonEntry = JSON.stringify({ type: 'http_response', status: result.status, sent: body, response: result.data }, null, 2)
    pushRawJson({ time: new Date().toLocaleString(), json: rawJsonEntry })
    nextTick(() => { rawJsonScrollTop.value = rawJsonScrollTop.value + 1 + 99999 })
    // 持久化保存
    request({
      url: '/publish-history',
      method: 'POST',
      data: {
        deviceId: deviceId.value,
        type: 'http',
        method: httpMethod.value,
        topic: httpUrl.value.trim(),
        payload: publishPayload.value.trim(),
        qos: '-',
        ok: ok ? 1 : 0,
        status: String(result.status || 'ERR'),
        url: httpUrl.value.trim(),
        responseData: typeof result.data === 'object' ? JSON.stringify(result.data) : String(result.data || '')
      }
    }).catch(() => {})
    uni.showToast({ title: ok ? '上报成功' : '服务器返回 ' + result.status, icon: ok ? 'success' : 'none' })
  } catch (e) {
    publishHistory.value.unshift({
      time: new Date().toLocaleString(),
      type: 'http',
      method: httpMethod.value,
      ok: false,
      status: 'ERR',
      url: httpUrl.value.trim(),
      topic: httpUrl.value.trim(),
      payload: publishPayload.value.trim(),
      qos: '-'
    })
    publishScrollTop.value = publishScrollTop.value + 1 + 99999
    // 追加错误到原始JSON区域
    const errJsonEntry = JSON.stringify({ type: 'http_response', status: 'ERR', error: e.message || '未知错误' }, null, 2)
    pushRawJson({ time: new Date().toLocaleString(), json: errJsonEntry })
    nextTick(() => { rawJsonScrollTop.value = rawJsonScrollTop.value + 1 + 99999 })
    // 持久化保存错误记录
    request({
      url: '/publish-history',
      method: 'POST',
      data: {
        deviceId: deviceId.value,
        type: 'http',
        method: httpMethod.value,
        topic: httpUrl.value.trim(),
        payload: publishPayload.value.trim(),
        qos: '-',
        ok: 0,
        status: 'ERR',
        url: httpUrl.value.trim(),
        responseData: JSON.stringify({ error: e.message || '未知错误' })
      }
    }).catch(() => {})
    uni.showToast({ title: '上报失败: ' + (e.message || '未知'), icon: 'none' })
  }
}

const openRealtimeItemAction = (idx) => {
  uni.showActionSheet({
    itemList: ['修改', '删除'],
    success: (res: any) => {
      if (res.tapIndex === 0) {
        editRealtimeName(idx)
      } else if (res.tapIndex === 1) {
        deleteRealtimeItem(idx)
      }
    }
  })
}

const deleteRealtimeItem = (idx) => {
  const item = realtimeDataList.value[idx]
  if (!item) return
  // 仅隐藏显示，不删除历史数据；重新进入页面后恢复
  if (!hiddenSensorKeys.value.includes(item.key)) {
    hiddenSensorKeys.value = [...hiddenSensorKeys.value, item.key]
  }
  realtimeDataList.value = realtimeDataList.value.filter((it: any) => it.key !== item.key)
}

const editRealtimeName = async (idx) => {
  const item = realtimeDataList.value[idx]
  uni.showModal({
    title: '修改传感器显示名称',
    editable: true,
    placeholderText: item.displayName,
    success: async (res) => {
      if (res.confirm && res.content) {
        await updateSensorDisplayName(deviceId.value, item.key, res.content)
        await loadSensorDisplayNames()
        rebuildSensorOptions()
        updateRealtimeAndRaw()
        renderChart()
        uni.showToast({ title: '修改成功', icon: 'success' })
      }
    }
  })
}

// 图表控制
const onSensorKeyChange = (e) => {
  const idx = e.detail.value
  const selected = sensorOptions.value[idx]
  if (selected) { selectedSensorKey.value = selected.value; updateCurrentSensorLabel(); renderChart() }
}
const onXAxisModeChange = (e) => { xAxisMode.value = e.detail.value === 0 ? 'index' : 'time'; renderChart() }
const onChartTypeChange = (e) => {
  chartTypeIndex.value = e.detail.value
  renderChart()
}


watch([selectedSensorKey, xAxisMode], () => renderChart())
watch(deviceOffline, (off) => {
  if (off) {
    currentMode.value = 'auto'
  } else {
    currentMode.value = (autoSwitchConfig.value && autoSwitchConfig.value.current_mode) || 'manual'
  }
})
watch(currentMenu, (val) => {
  if (val === 'publish') {
    loadPublishConfig(); loadPublishHistory(); loadSensorRecords()
  } else if (val === 'data') {
    if (chartInstance) {
      chartInstance.dispose()
      chartInstance = null
    }
    nextTick(() => { initChart() })
  } else if (val === 'switch') {
    loadSwitches()
    loadSchedules()
    loadThresholds()
    loadAutoSwitch()
    if (!scheduleTimer) {
      scheduleTimer = setInterval(checkSchedules, 1000)
    }
    if (!countdownTimer) {
      countdownTimer = setInterval(() => { countdownTick.value++ }, 1000)
    }
  } else if (val === 'webview') {
    loadWebviewConfig()
    loadScreenshots()
  } else {
    if (scheduleTimer) {
      clearInterval(scheduleTimer)
      scheduleTimer = null
    }
    if (countdownTimer) {
      clearInterval(countdownTimer)
      countdownTimer = null
    }
  }
})

const onDeviceNameChange = (data) => {
  if (data.deviceId === deviceId.value && data.deviceType === deviceType.value) deviceName.value = data.newName
}

onMounted(async () => {
  // 重置模块级状态，确保每次进入详情页都是全新的数据
  lastHistoryTs = 0
  rawJsonPushedTs = 0
  lastDataReceivedAt = 0
  deviceOffline.value = false
  rawJsonList.value = []
  rawJsonPage.value = 1
  rawJsonFollowLatest = true
  historyRecords.value = []
  realtimeDataMap.value = {}
  realtimeDataList.value = []

  await loadSubscription()
  await loadFlagConfig()
  updateCurrentTime()
  setInterval(updateCurrentTime, 1000)
  await loadSensorDisplayNames()
  await loadThresholds()
  await loadThemes()
  await loadWebviewConfig()

  initChart()
  await loadHistoryData()
  // 加载持久化的HTTP响应到原始JSON区域
  loadHttpRawJson()
  // MQTT 直连：仅当首页已连接订阅时才直连，否则只轮询历史数据
  if (uni.getStorageSync('activeBrokerHost')) {
    connectRealtimeMqtt()
  } else {
    console.log('[详情页MQTT] 首页未连接订阅，跳过实时直连')
  }
  startPolling()
  startOfflineWatch()
  uni.$on('deviceNameChanged', onDeviceNameChange)
})

onUnmounted(() => {
  if (pollingTimer) clearInterval(pollingTimer)
  if (offlineTimer) clearInterval(offlineTimer)
  if (scheduleTimer) clearInterval(scheduleTimer)
  if (countdownTimer) clearInterval(countdownTimer)
  if (webviewTimer) clearInterval(webviewTimer)
  if (mqttPublishClient && mqttPublishClient.isConnected()) { mqttPublishClient.disconnect() }
  if (switchMqttClient && switchMqttClient.isConnected()) { switchMqttClient.disconnect() }
  if (realtimeMqttClient && realtimeMqttClient.isConnected()) { realtimeMqttClient.disconnect() }
  if (resizeHandler) { window.removeEventListener('resize', resizeHandler); resizeHandler = null }
  if (chartInstance) { chartInstance.dispose(); chartInstance = null }
  uni.$off('deviceNameChanged', onDeviceNameChange)
})

  // ========== 数据查询 ==========
  const queryTableNames = ['传感器历史', '报警记录', 'MQTT原始消息', '截图记录', '发送记录']
  const queryTableValues = ['sensor_history', 'alarm_history', 'mqtt_messages', 'webview_screenshots', 'publish_history']
  const queryTypeLabels = ['全部', 'HTTP', 'MQTT']
  const queryOkLabels = ['全部', '成功', '失败']
  const queryTableIndex = ref(0)
  const queryKeyword1 = ref('')
  const queryKeyword2 = ref('')
  const queryKeywordOp = ref(0)
  // 各表可选的关键词字段（表头），value 与后端字段映射一致
  const queryFieldDefs = [
    [
      { label: '全部', value: '' },
      { label: '传感器名', value: 'sensor_name' },
      { label: '显示名称', value: 'display_name' },
      { label: '值', value: 'value' }
    ],
    [
      { label: '全部', value: '' },
      { label: '传感器名', value: 'sensor_name' },
      { label: '报警消息', value: 'alarm_message' }
    ],
    [
      { label: '全部', value: '' },
      { label: 'JSON数据', value: 'json_data' }
    ],
    [
      { label: '全部', value: '' },
      { label: '检测结果', value: 'json_data' }
    ],
    [
      { label: '全部', value: '' },
      { label: '主题', value: 'topic' },
      { label: 'URL', value: 'url' },
      { label: '发送数据', value: 'payload' },
      { label: '响应数据', value: 'response_data' }
    ]
  ]
  const queryFieldLabels = computed(() => queryFieldDefs[queryTableIndex.value].map((d: any) => d.label))
  const queryKeyword1Field = ref(0)
  const queryKeyword2Field = ref(0)
  const queryDate = ref('')
  const queryTime = ref('')
  const queryEndDate = ref('')
  const queryEndTime = ref('')
  const queryResults = ref([])
  const queryTotal = ref(0)
  const queryDone = ref(false)
  const queryPage = ref(1)
  const queryPageSize = ref(50)
  const queryJumpPage = ref('')
  const queryPageSizeOptions = [10, 20, 50, 100, 200]
  const queryTotalPages = computed(() => Math.max(1, Math.ceil(queryTotal.value / queryPageSize.value)))
  const queryPageSizeIndex = computed(() => {
    const idx = queryPageSizeOptions.indexOf(queryPageSize.value)
    return idx >= 0 ? idx : 2
  })
  const queryPageList = computed(() => {
    const total = queryTotalPages.value
    const cur = queryPage.value
    if (total <= 7) {
      const arr = []
      for (let i = 1; i <= total; i++) arr.push(i)
      return arr
    }
    const pages = new Set([1, total, cur - 1, cur, cur + 1])
    const sorted = Array.from(pages).filter(p => p >= 1 && p <= total).sort((a, b) => a - b)
    const list = []
    let prev = 0
    for (const p of sorted) {
      if (prev && p - prev > 1) list.push(-1)
      list.push(p)
      prev = p
    }
    return list
  })
  const queryExact = ref(0)
  const queryOrder = ref(0)
  const queryValueMin = ref('')
  const queryValueMax = ref('')
  const queryTypeIndex = ref(0)
  const queryOkIndex = ref(0)
  const querySortField = ref('')
  const querySortDir = ref('')
  const queryResultsRaw = ref([])

  const onQueryTableChange = (e) => {
    queryTableIndex.value = e.detail.value
    queryKeyword1Field.value = 0
    queryKeyword2Field.value = 0
    queryResults.value = []
    queryResultsRaw.value = []
    querySortField.value = ''
    querySortDir.value = ''
    queryTotal.value = 0
    queryPage.value = 1
  }

  const onQueryDateChange = (e) => { queryDate.value = e.detail.value }
  const queryTimeRange = [
    Array.from({length: 24}, (_, i) => String(i).padStart(2, '0')),
    Array.from({length: 60}, (_, i) => String(i).padStart(2, '0')),
    Array.from({length: 60}, (_, i) => String(i).padStart(2, '0'))
  ]
  const queryTimeIndex = ref([0, 0, 0])
  const onQueryTimeColumnChange = (e) => {
    const { column, value } = e.detail
    queryTimeIndex.value[column] = value
    queryTimeIndex.value = [...queryTimeIndex.value]
  }
  const onQueryTimeChange = (e) => {
    queryTimeIndex.value = e.detail.value
    const [h, m, s] = queryTimeRange.map((arr, i) => arr[queryTimeIndex.value[i]])
    queryTime.value = `${h}:${m}:${s}`
  }
  const queryEndTimeIndex = ref([0, 0, 0])
  const onQueryEndDateChange = (e) => { queryEndDate.value = e.detail.value }
  const onQueryEndTimeColumnChange = (e) => {
    const { column, value } = e.detail
    queryEndTimeIndex.value[column] = value
    queryEndTimeIndex.value = [...queryEndTimeIndex.value]
  }
  const onQueryEndTimeChange = (e) => {
    queryEndTimeIndex.value = e.detail.value
    const [h, m, s] = queryTimeRange.map((arr, i) => arr[queryEndTimeIndex.value[i]])
    queryEndTime.value = `${h}:${m}:${s}`
  }
  const onQueryTypeChange = (e) => { queryTypeIndex.value = e.detail.value }
  const onQueryOkChange = (e) => { queryOkIndex.value = e.detail.value }
  const onQueryKeyword1FieldChange = (e) => { queryKeyword1Field.value = e.detail.value }
  const onQueryKeyword2FieldChange = (e) => { queryKeyword2Field.value = e.detail.value }

  const sortIcon = (field: string): string => {
    if (querySortField.value !== field) return '⇅'
    return querySortDir.value === 'asc' ? '↑' : '↓'
  }
  const applyQuerySort = () => {
    const field = querySortField.value
    if (!field) {
      queryResults.value = [...queryResultsRaw.value]
      return
    }
    const dir = querySortDir.value === 'asc' ? 1 : -1
    const arr = [...queryResultsRaw.value]
    arr.sort((a: any, b: any) => {
      const va = a[field]
      const vb = b[field]
      const na = Number(va)
      const nb = Number(vb)
      const vaNum = va !== null && va !== undefined && va !== '' && !isNaN(na)
      const vbNum = vb !== null && vb !== undefined && vb !== '' && !isNaN(nb)
      if (vaNum && vbNum) return (na - nb) * dir
      const sa = va === null || va === undefined ? '' : String(va)
      const sb = vb === null || vb === undefined ? '' : String(vb)
      if (sa < sb) return -1 * dir
      if (sa > sb) return 1 * dir
      return 0
    })
    queryResults.value = arr
  }
  const onQuerySort = (field: string) => {
    if (querySortField.value !== field) {
      querySortField.value = field
      querySortDir.value = 'asc'
    } else if (querySortDir.value === 'asc') {
      querySortDir.value = 'desc'
    } else {
      querySortField.value = ''
      querySortDir.value = ''
    }
    applyQuerySort()
  }

  const clearQuery = () => {
    queryKeyword1.value = ''
    queryKeyword2.value = ''
    queryKeyword1Field.value = 0
    queryKeyword2Field.value = 0
    queryKeywordOp.value = 0
    queryDate.value = ''
    queryTime.value = ''
    queryTimeIndex.value = [0, 0, 0]
    queryEndDate.value = ''
    queryEndTime.value = ''
    queryEndTimeIndex.value = [0, 0, 0]
    queryExact.value = 0
    queryOrder.value = 0
    queryValueMin.value = ''
    queryValueMax.value = ''
    queryTypeIndex.value = 0
    queryOkIndex.value = 0
    querySortField.value = ''
    querySortDir.value = ''
    queryResultsRaw.value = []
    queryResults.value = []
    queryTotal.value = 0
    queryDone.value = false
    queryPage.value = 1
  }

  // 构造查询/删除共用的过滤参数（includePage 决定是否带分页）
  const buildQueryParams = (includePage: boolean): any => {
    const table = queryTableValues[queryTableIndex.value]
    const params: any = { deviceId: deviceId.value, table, deviceType: deviceType.value }
    if (includePage) {
      params.page = queryPage.value
      params.pageSize = queryPageSize.value
    }
    if (queryKeyword1.value.trim()) {
      params.keyword1 = queryKeyword1.value.trim()
      const f1 = queryFieldDefs[queryTableIndex.value][queryKeyword1Field.value].value
      if (f1) params.keyword1Field = f1
    }
    if (queryKeyword2.value.trim()) {
      params.keyword2 = queryKeyword2.value.trim()
      const f2 = queryFieldDefs[queryTableIndex.value][queryKeyword2Field.value].value
      if (f2) params.keyword2Field = f2
    }
    params.keywordOp = queryKeywordOp.value === 1 ? 'or' : 'and'
    params.exact = queryExact.value === 1 ? '1' : '0'
    params.order = queryOrder.value === 1 ? 'asc' : 'desc'
    if (queryValueMin.value !== '') params.valueMin = queryValueMin.value
    if (queryValueMax.value !== '') params.valueMax = queryValueMax.value
    if (queryTableIndex.value === 4) {
      if (queryTypeIndex.value === 1) params.type = 'http'
      else if (queryTypeIndex.value === 2) params.type = 'mqtt'
      if (queryOkIndex.value === 1) params.ok = '1'
      else if (queryOkIndex.value === 2) params.ok = '0'
    }
    // 开始时间（日期 + 时分秒，时分不选默认 00:00:00）
    if (queryDate.value) {
      const t = new Date(queryDate.value + (queryTime.value ? ' ' + queryTime.value : ' 00:00:00')).getTime()
      if (!isNaN(t)) params.startTime = Math.floor(t / 1000)
    }
    // 结束时间（日期 + 时分秒，时分不选默认 23:59:59）
    if (queryEndDate.value) {
      const t = new Date(queryEndDate.value + (queryEndTime.value ? ' ' + queryEndTime.value : ' 23:59:59')).getTime()
      if (!isNaN(t)) params.endTime = Math.floor(t / 1000)
    }
    return params
  }

  const doQuery = async () => {
    const table = queryTableValues[queryTableIndex.value]
    const params = buildQueryParams(true)
    console.log('[doQuery] deviceId=', deviceId.value, 'table=', table, 'deviceType=', deviceType.value, 'queryTableIndex=', queryTableIndex.value)
    console.log('[doQuery] 请求参数:', JSON.stringify(params))
    try {
      const data = await queryData(params)
      console.log('[doQuery] 返回结果: list.length=', data.list?.length, 'total=', data.total)
      let list = data.list || []
      // 特殊设备 + 传感器历史：把 json_data 拆成 sensor_name + value 行，和普通设备统一展示
      if (deviceType.value === 'special' && table === 'sensor_history') {
        const expanded: any[] = []
        for (const row of list) {
          try {
            const obj = JSON.parse(row.json_data)
            for (const [key, val] of Object.entries(obj)) {
              expanded.push({
                id: row.id + '_' + key,
                sensor_name: key,
                display_name: sensorDisplayNames.value[key] || '',
                value: typeof val === 'object' ? JSON.stringify(val) : val,
                timestamp: row.timestamp
              })
            }
          } catch (e) { /* skip */ }
        }
        list = expanded
      }
      queryResultsRaw.value = list
      applyQuerySort()
      queryTotal.value = data.total || 0
      queryDone.value = true
      // 删除记录后当前页可能越界，回退到最后一页重查
      const tp = Math.max(1, Math.ceil(queryTotal.value / queryPageSize.value))
      if (queryPage.value > tp) {
        queryPage.value = tp
        doQuery()
        return
      }
    } catch (err) {
      console.error('[doQuery] 查询失败:', err)
      uni.showToast({ title: '查询失败', icon: 'none' })
    }
  }

  // 删除当前查询条件下的全部记录（二次确认）
  const deleteAllQueryRecords = async () => {
    if (!queryDone.value || queryResults.value.length === 0) return
    const params = buildQueryParams(false)
    const count = queryTotal.value
    uni.showModal({
      title: '删除确认',
      content: '将删除当前查询条件下的全部 ' + count + ' 条数据，且无法恢复，是否继续？',
      confirmText: '确认删除',
      confirmColor: '#ff3b30',
      success: (res: any) => {
        if (!res.confirm) return
        uni.showModal({
          title: '再次确认',
          content: '真的要删除这 ' + count + ' 条数据吗？此操作不可撤销。',
          confirmText: '删除',
          confirmColor: '#ff3b30',
          success: async (res2: any) => {
            if (!res2.confirm) return
            try {
              const data = await deleteQueryRecords(params)
              uni.showToast({ title: '已删除 ' + (data.affected || 0) + ' 条', icon: 'success' })
              queryResultsRaw.value = []
              queryResults.value = []
              queryTotal.value = 0
              queryDone.value = true
            } catch (e) {
              console.error('[deleteAllQueryRecords] 删除失败:', e)
              uni.showToast({ title: '删除失败', icon: 'none' })
            }
          }
        })
      }
    })
  }

  const goQueryPage = (p) => {
    if (p < 1 || p > queryTotalPages.value || p === queryPage.value) return
    queryPage.value = p
    doQuery()
  }

  const onQueryPageSizeChange = (e) => {
    const idx = Number(e.detail.value)
    queryPageSize.value = queryPageSizeOptions[idx]
    queryPage.value = 1
    doQuery()
  }

  const onQueryJumpPage = () => {
    const p = parseInt(queryJumpPage.value)
    if (!p || p < 1) {
      uni.showToast({ title: '请输入有效页码', icon: 'none' })
      return
    }
    if (p > queryTotalPages.value) {
      uni.showToast({ title: '超过总页数', icon: 'none' })
      return
    }
    queryPage.value = p
    queryJumpPage.value = ''
    doQuery()
  }

  const onQueryRowAction = (row) => {
    const table = queryTableValues[queryTableIndex.value]
    const itemList = ['修改', '删除']
    uni.showActionSheet({
      itemList,
      success: (res) => {
        if (res.tapIndex === 0) {
          openQueryEditDialog(row, table)
        } else if (res.tapIndex === 1) {
          confirmDeleteQueryRow(row, table)
        }
      }
    })
  }

  // 查询记录通用编辑弹窗
  const showQueryEditForm = ref(false)
  const queryEditForm = ref<any>({ table: '', id: null, source: '' })
  const queryEditFieldDefs = ref<any[]>([])
  const queryEditError = ref('')

  const queryEditFieldDefsMap: Record<string, any[]> = {
    sensor_history: [
      { key: 'sensor_name', label: '键名' },
      { key: 'display_name', label: '显示名称' },
      { key: 'value', label: '值' },
      { key: 'timestamp', label: '时间', type: 'ms' }
    ],
    alarm_history: [
      { key: 'sensor_name', label: '传感器名' },
      { key: 'alarm_message', label: '报警消息' },
      { key: 'timestamp', label: '时间', type: 'ms' }
    ],
    mqtt_messages: [
      { key: 'json_data', label: 'JSON数据', type: 'textarea' },
      { key: 'time', label: '时间', type: 'str' }
    ],
    webview_screenshots: [
      { key: 'json_data', label: '检测结果', type: 'textarea' },
      { key: 'timestamp', label: '时间', type: 'ms' }
    ],
    publish_history: [
      { key: 'type', label: '类型' },
      { key: 'topic', label: '主题' },
      { key: 'url', label: 'URL' },
      { key: 'payload', label: '发送数据', type: 'textarea' },
      { key: 'response_data', label: '响应数据', type: 'textarea' },
      { key: 'ok', label: '状态(1成功/0失败)' },
      { key: 'created_at', label: '时间', type: 'str' }
    ]
  }

  const msToReadable = (ms: any): string => {
    const n = Number(ms)
    if (!n || isNaN(n)) return ms === null || ms === undefined ? '' : String(ms)
    const d = new Date(n)
    const pad = (x: number): string => String(x).padStart(2, '0')
    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds())
  }
  const parseTimeToMs = (s: string): number => {
    const t = s.trim()
    if (/^\d+$/.test(t)) return Number(t)
    const m = t.match(/^(\d{4})-(\d{1,2})-(\d{1,2})\s+(\d{1,2}):(\d{1,2}):(\d{1,2})$/)
    if (!m) return NaN
    const year = Number(m[1])
    const month = Number(m[2])
    const day = Number(m[3])
    const hour = Number(m[4])
    const minute = Number(m[5])
    const second = Number(m[6])
    if (month < 1 || month > 12 || day < 1 || day > 31) return NaN
    if (hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59) return NaN
    const d = new Date(year, month - 1, day, hour, minute, second)
    if (d.getFullYear() !== year || d.getMonth() !== month - 1 || d.getDate() !== day) return NaN
    if (d.getHours() !== hour || d.getMinutes() !== minute || d.getSeconds() !== second) return NaN
    return d.getTime()
  }
  const formatDateStr = (val: any): string => {
    if (val === null || val === undefined) return ''
    if (typeof val === 'object') {
      const t = (val as any).getTime ? (val as any).getTime() : NaN
      if (!isNaN(t)) return msToReadable(t)
    }
    return String(val)
  }

  const closeQueryEditForm = () => {
    showQueryEditForm.value = false
    queryEditError.value = ''
  }

  const saveQueryEdit = async () => {
    const { table, id, source } = queryEditForm.value
    const fields: Record<string, any> = {}
    let displayName = ''
    for (const def of queryEditFieldDefs.value) {
      if (def.key === 'display_name') {
        displayName = def.value === null || def.value === undefined ? '' : String(def.value)
        continue
      }
      let v = def.value
      const raw = v === null || v === undefined ? '' : String(v).trim()
      if (def.type === 'ms') {
        const ms = parseTimeToMs(raw)
        if (isNaN(ms)) {
          queryEditError.value = def.label + ' 格式错误（如 2026-09-19 08:30:00）'
          return
        }
        v = ms
      } else if (def.type === 'str') {
        if (raw === '' || /^\d+$/.test(raw) || isNaN(parseTimeToMs(raw))) {
          queryEditError.value = def.label + ' 格式错误（如 2026-09-19 08:30:00）'
          return
        }
        v = raw
      }
      fields[def.key] = v
    }
    // alarm_history 的 threshold 来源：字段名映射到 threshold_alarms 列
    if (table === 'alarm_history' && source === 'threshold') {
      if (fields.sensor_name !== undefined) fields.sensor_key = fields.sensor_name
      if (fields.timestamp !== undefined) fields.alarm_time = fields.timestamp
    }
    try {
      await updateQueryRecord({ table, id, source, fields })
      if (table === 'sensor_history' && displayName.trim() !== '') {
        await updateSensorDisplayName(deviceId.value, String(fields.sensor_name === undefined ? '' : fields.sensor_name), displayName)
        await loadSensorDisplayNames()
      }
      uni.showToast({ title: '修改成功', icon: 'success' })
      showQueryEditForm.value = false
      queryEditError.value = ''
      doQuery()
      refreshHistoryChart()
    } catch (e) { queryEditError.value = '修改失败' }
  }

  const openQueryEditDialog = (row, table) => {
    const defs = queryEditFieldDefsMap[table]
    if (!defs) {
      uni.showToast({ title: '该表暂不支持编辑', icon: 'none' })
      return
    }
    const fieldDefs = defs.map((d: any) => {
      let val: any = row[d.key]
      if (d.type === 'ms') val = msToReadable(val)
      else if (d.type === 'str') val = formatDateStr(val)
      else val = (val === null || val === undefined) ? '' : String(val)
      return { key: d.key, label: d.label, type: d.type, value: val }
    })
    queryEditForm.value = { table, id: row.id, source: row.source || '' }
    queryEditFieldDefs.value = fieldDefs
    queryEditError.value = ''
    showQueryEditForm.value = true
  }

  const confirmDeleteQueryRow = (row, table) => {
    uni.showModal({
      title: '确认删除',
      content: '确定删除该条记录吗？此操作不可撤销。',
      confirmColor: '#ff3b30',
      success: async (res) => {
        if (res.confirm) {
          try {
            await deleteQueryRecord(table, row.id, row.source)
            uni.showToast({ title: '删除成功', icon: 'success' })
            doQuery()
            if (table === 'sensor_history') refreshHistoryChart()
          } catch (e) { uni.showToast({ title: '删除失败', icon: 'none' }) }
        }
      }
    })
  }

  // 删除/修改传感器历史后，重新拉取历史数据刷新折线图 + 实时数据列表
  const refreshHistoryChart = async () => {
    lastHistoryTs = 0
    rawJsonPushedTs = 0
    historyRecords.value = []
    realtimeDataMap.value = {}
    realtimeDataList.value = []
    rawJsonList.value = []
    await loadHistoryData()
  }

  const viewQueryScreenshot = (row) => {
    let objects = []
    try {
      if (row.json_data) {
        const parsed = JSON.parse(row.json_data)
        objects = parsed.objects || []
      }
    } catch (e) {}
    screenshotPreview.value = { image: row.image_base64, objects }
    showScreenshotPreview.value = true
  }

const goBack = () => { uni.navigateBack() }
</script>

